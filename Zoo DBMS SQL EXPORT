create definer = avnadmin@`%` view vw_enclosure_occupancy as
select `e`.`Enclosure_ID`                                                     AS `Enclosure_ID`,
       `e`.`Enclosure_Name`                                                   AS `Enclosure_Name`,
       `e`.`Location`                                                         AS `Location`,
       `e`.`Status`                                                           AS `Status`,
       `e`.`Capacity`                                                         AS `Capacity`,
       count(`a`.`Animal_ID`)                                                 AS `Active_Animals`,
       (`e`.`Capacity` - count(`a`.`Animal_ID`))                              AS `Spaces_Left`,
       round(((100 * count(`a`.`Animal_ID`)) / nullif(`e`.`Capacity`, 0)), 1) AS `Pct_Full`
from (`Team4-Zoo-Database`.`Enclosure` `e` left join `Team4-Zoo-Database`.`Animal` `a`
      on (((`a`.`Enclosure_ID` = `e`.`Enclosure_ID`) and (`a`.`Is_Active` = 1))))
group by `e`.`Enclosure_ID`, `e`.`Enclosure_Name`, `e`.`Location`, `e`.`Status`, `e`.`Capacity`;

create
    definer = avnadmin@`%` function fn_least_busy_vet() returns int reads sql data
BEGIN
    DECLARE v_vet INT DEFAULT NULL;
    SELECT v.Employee_ID INTO v_vet
    FROM Veterinarian v
             LEFT JOIN Care_Task t
                       ON t.Assigned_Employee_ID = v.Employee_ID
                           AND t.Status IN ('Open', 'In Progress')
    GROUP BY v.Employee_ID
    ORDER BY COUNT(t.Task_ID), v.Employee_ID
    LIMIT 1;
    RETURN v_vet;
END;

create
    definer = avnadmin@`%` function fn_primary_vet(p_animal int) returns int reads sql data
BEGIN
    RETURN (SELECT ae.Employee_ID
            FROM Animal_Employee ae
                     JOIN Veterinarian v ON v.Employee_ID = ae.Employee_ID
            WHERE ae.Animal_ID = p_animal
              AND ae.Assigned_Role = 'Primary Vet'
            ORDER BY ae.Employee_ID
            LIMIT 1);
END;

create
    definer = avnadmin@`%` function fn_vet_for_animal(p_animal int) returns int reads sql data
BEGIN
    RETURN COALESCE(fn_primary_vet(p_animal), fn_least_busy_vet());
END;

create
    definer = avnadmin@`%` procedure sp_check_feed_stock(IN p_feed int) modifies sql data
BEGIN
    DECLARE v_name VARCHAR(100);
    DECLARE v_unit VARCHAR(20);
    DECLARE v_stock DECIMAL(10, 2);
    DECLARE v_reorder DECIMAL(10, 2);
    DECLARE v_supplier INT;
    DECLARE v_cost DECIMAL(10, 2);
    DECLARE v_daily DECIMAL(10, 2);
    DECLARE v_qty DECIMAL(10, 2);
    DECLARE v_po INT;
    DECLARE v_days VARCHAR(20);

    SELECT Feed_Name, Unit, COALESCE(Quantity_In_Stock, 0), Reorder_Level, Supplier_ID, Unit_Cost
    INTO v_name, v_unit, v_stock, v_reorder, v_supplier, v_cost
    FROM Feed WHERE Feed_ID = p_feed;

    IF v_reorder > 0 AND v_stock <= v_reorder
        AND NOT EXISTS (SELECT 1 FROM Purchase_Order
                        WHERE Feed_ID = p_feed AND Status IN ('Draft', 'Ordered')) THEN

        SET v_daily = (SELECT COALESCE(SUM(Quantity), 0) FROM Feeding_Schedule
                       WHERE Feed_ID = p_feed AND Is_Active = 1);
        SET v_qty = GREATEST(v_daily * 14, v_reorder * 2 - v_stock);
        SET v_days = IF(v_daily > 0, CONCAT('about ', FLOOR(v_stock / v_daily), ' days'), 'unknown days');

        INSERT INTO Purchase_Order (Supplier_ID, Feed_ID, Quantity, Unit_Cost, Expected_Delivery, Status, Auto_Generated)
        VALUES (v_supplier, p_feed, v_qty, v_cost, CURDATE() + INTERVAL 3 DAY, 'Draft', 1);
        SET v_po = LAST_INSERT_ID();

        INSERT INTO Care_Task (Task_Category, Title, Description, Priority, Due_At, Source_Type, Source_ID)
        VALUES ('Supply', CONCAT('Approve feed order: ', v_name),
                CONCAT(v_stock, ' ', v_unit, ' left (', v_days, ' of supply). Draft order #', v_po,
                       ' for ', v_qty, ' ', v_unit,
                       IF(v_supplier IS NULL, '. No supplier on file - choose one.', '.')),
                IF(v_daily > 0 AND v_stock < v_daily * 3, 'Urgent', 'High'),
                NOW() + INTERVAL 1 DAY, 'Purchase_Order', v_po);

        INSERT INTO Staff_Notification (Employee_ID, Priority, Message)
        SELECT DISTINCT fs.Keeper_Employee_ID, 'Important',
                        CONCAT(v_name, ' is running low (', v_stock, ' ', v_unit, ', ', v_days,
                               '). A restock order has been drafted.')
        FROM Feeding_Schedule fs
        WHERE fs.Feed_ID = p_feed AND fs.Is_Active = 1 AND fs.Keeper_Employee_ID IS NOT NULL;
    END IF;
END;

create
    definer = avnadmin@`%` procedure sp_notify_enclosure_keepers(IN p_enclosure int, IN p_animal int,
                                                                 IN p_priority varchar(20), IN p_message varchar(500))
    modifies sql data
BEGIN
    INSERT INTO Staff_Notification (Employee_ID, Animal_ID, Enclosure_ID, Priority, Message)
    SELECT DISTINCT ke.Employee_ID, p_animal, p_enclosure, p_priority, p_message
    FROM Keeper_Enclosure ke
    WHERE ke.Enclosure_ID = p_enclosure
      AND (ke.Assignment_Start_Date IS NULL OR ke.Assignment_Start_Date <= CURDATE())
      AND (ke.Assignment_End_Date IS NULL OR ke.Assignment_End_Date >= CURDATE());
END;

create
    definer = avnadmin@`%` procedure sp_reassign_for_absence(IN p_emp int, IN p_date date, IN p_dept int)
    modifies sql data
BEGIN
    DECLARE v_cover INT DEFAULT NULL;
    DECLARE v_moved INT DEFAULT 0;
    DECLARE v_name VARCHAR(101);
    DECLARE v_cover_name VARCHAR(101);
    DECLARE v_manager INT;

    SET v_name = (SELECT CONCAT(First_Name, ' ', Last_Name) FROM Employee WHERE Employee_ID = p_emp);
    SET v_manager = (SELECT Manager_Employee_ID FROM Department WHERE Department_ID = p_dept);

    SET v_cover = (SELECT s.Employee_ID
                   FROM Employee_Shift s
                            JOIN Employee e ON e.Employee_ID = s.Employee_ID
                            LEFT JOIN Care_Task t ON t.Assigned_Employee_ID = s.Employee_ID
                       AND t.Status IN ('Open', 'In Progress')
                   WHERE s.Shift_Date = p_date
                     AND s.Status <> 'Absent'
                     AND s.Employee_ID <> p_emp
                     AND COALESCE(s.Department_ID, e.Department_ID) <=> p_dept
                   GROUP BY s.Employee_ID
                   ORDER BY COUNT(t.Task_ID), s.Employee_ID
                   LIMIT 1);
    SET v_cover_name = (SELECT CONCAT(First_Name, ' ', Last_Name) FROM Employee WHERE Employee_ID = v_cover);

    UPDATE Care_Task
    SET Assigned_Employee_ID = v_cover
    WHERE Assigned_Employee_ID = p_emp
      AND Status IN ('Open', 'In Progress')
      AND (Due_At IS NULL OR DATE(Due_At) <= p_date);
    SET v_moved = ROW_COUNT();

    IF v_moved > 0 AND v_cover IS NOT NULL THEN
        INSERT INTO Staff_Notification (Employee_ID, Priority, Message)
        VALUES (v_cover, 'Important',
                CONCAT('You are covering ', v_moved, ' task(s) for ', v_name, ', who is absent on ', p_date, '.'));
    END IF;

    IF v_manager IS NOT NULL AND v_manager <> p_emp THEN
        INSERT INTO Staff_Notification (Employee_ID, Priority, Message)
        VALUES (v_manager, IF(v_cover IS NULL AND v_moved > 0, 'Urgent', 'Info'),
                CONCAT(v_name, ' is absent on ', p_date, '. ',
                       IF(v_moved = 0, 'No open tasks were affected.',
                          IF(v_cover IS NULL,
                             CONCAT(v_moved, ' task(s) are UNASSIGNED - nobody else in the department is on shift.'),
                             CONCAT(v_moved, ' task(s) reassigned to ', v_cover_name, '.')))));
    END IF;
END;

