create definer = avnadmin@`%` trigger trg_emergency_repair_done
    after update
    on Maintenance
    for each row
BEGIN
    IF NEW.Status = 'Completed' AND NOT (OLD.Status <=> 'Completed')
        AND NEW.Priority = 'Emergency' AND NEW.Enclosure_ID IS NOT NULL
        AND NOT EXISTS (SELECT 1 FROM Maintenance
                        WHERE Enclosure_ID = NEW.Enclosure_ID AND Priority = 'Emergency'
                          AND Maintenance_ID <> NEW.Maintenance_ID
                          AND NOT (Status <=> 'Completed')) THEN

        INSERT INTO Care_Task (Enclosure_ID, Task_Category, Title, Description, Priority,
                               Assigned_Employee_ID, Due_At, Source_Type, Source_ID)
        VALUES (NEW.Enclosure_ID, 'Inspection',
                CONCAT('Re-inspect ', (SELECT Enclosure_Name FROM Enclosure WHERE Enclosure_ID = NEW.Enclosure_ID),
                       ' before reopening'),
                CONCAT('Emergency repair #', NEW.Maintenance_ID, ' completed. Record a Pass inspection to reopen.'),
                'High',
                (SELECT Inspector_Employee_ID FROM Habitat_Inspection WHERE Inspection_ID = NEW.Inspection_ID),
                NOW() + INTERVAL 1 DAY, 'Maintenance', NEW.Maintenance_ID);
    END IF;
END;

