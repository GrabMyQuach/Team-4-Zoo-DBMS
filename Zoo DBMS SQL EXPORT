create definer = avnadmin@`%` trigger trg_feeding_consumption
    after insert
    on Feeding_Log
    for each row
BEGIN
    DECLARE v_feed INT;
    DECLARE v_qty DECIMAL(10, 2);

    IF NEW.Status IN ('Completed', 'Partial') THEN
        SELECT Feed_ID, COALESCE(NEW.Quantity_Given, Quantity) INTO v_feed, v_qty
        FROM Feeding_Schedule WHERE Schedule_ID = NEW.Schedule_ID;

        UPDATE Feed
        SET Quantity_In_Stock = GREATEST(COALESCE(Quantity_In_Stock, 0) - v_qty, 0)
        WHERE Feed_ID = v_feed;

        CALL sp_check_feed_stock(v_feed);
    END IF;
END;

create definer = avnadmin@`%` trigger trg_feeding_problem
    after insert
    on Feeding_Log
    for each row
BEGIN
    DECLARE v_animal INT;
    DECLARE v_name VARCHAR(100);
    DECLARE v_enclosure INT;
    DECLARE v_keeper INT;
    DECLARE v_feed VARCHAR(100);
    DECLARE v_time TIME;
    DECLARE v_problems INT DEFAULT 0;

    IF NEW.Status IN ('Missed', 'Refused') THEN
        SELECT fs.Animal_ID, a.Animal_Name, a.Enclosure_ID, fs.Keeper_Employee_ID, f.Feed_Name, fs.Feeding_Time
        INTO v_animal, v_name, v_enclosure, v_keeper, v_feed, v_time
        FROM Feeding_Schedule fs
                 JOIN Animal a ON a.Animal_ID = fs.Animal_ID
                 JOIN Feed f ON f.Feed_ID = fs.Feed_ID
        WHERE fs.Schedule_ID = NEW.Schedule_ID;

        IF NEW.Status = 'Missed' THEN
            INSERT INTO Care_Task (Animal_ID, Enclosure_ID, Task_Category, Title, Description, Priority,
                                   Assigned_Employee_ID, Due_At, Source_Type, Source_ID)
            VALUES (v_animal, v_enclosure, 'Feeding',
                    CONCAT('PRIORITY make-up feeding: ', v_name),
                    CONCAT('Missed the ', TIME_FORMAT(v_time, '%h:%i %p'), ' feeding of ', v_feed,
                           ' on ', NEW.Feeding_Date, '.'),
                    'Urgent', v_keeper, NOW() + INTERVAL 1 HOUR, 'Feeding_Log', NEW.Feeding_Log_ID);

            CALL sp_notify_enclosure_keepers(v_enclosure, v_animal, 'Urgent',
                                             CONCAT(v_name, ' missed the ', TIME_FORMAT(v_time, '%h:%i %p'),
                                                    ' feeding (', v_feed, '). Make-up feeding due within 1 hour.'));
        END IF;

        SELECT COUNT(*) INTO v_problems
        FROM Feeding_Log fl
                 JOIN Feeding_Schedule fs ON fs.Schedule_ID = fl.Schedule_ID
        WHERE fs.Animal_ID = v_animal
          AND fl.Status IN ('Missed', 'Refused')
          AND fl.Feeding_Date BETWEEN NEW.Feeding_Date - INTERVAL 2 DAY AND NEW.Feeding_Date;

        IF v_problems >= 2 AND NOT EXISTS (
            SELECT 1 FROM Care_Task
            WHERE Animal_ID = v_animal AND Task_Category = 'Veterinary'
              AND Source_Type = 'Feeding_Log' AND Status IN ('Open', 'In Progress')) THEN

            INSERT INTO Care_Task (Animal_ID, Enclosure_ID, Task_Category, Title, Description, Priority,
                                   Assigned_Employee_ID, Due_At, Source_Type, Source_ID)
            VALUES (v_animal, v_enclosure, 'Veterinary',
                    CONCAT('Appetite/welfare check: ', v_name),
                    CONCAT(v_problems, ' missed or refused feedings in the last 3 days.'),
                    'High', fn_vet_for_animal(v_animal), NOW() + INTERVAL 1 DAY, 'Feeding_Log', NEW.Feeding_Log_ID);
        END IF;
    END IF;
END;

