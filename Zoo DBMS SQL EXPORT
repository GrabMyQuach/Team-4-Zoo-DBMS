create definer = avnadmin@`%` trigger check_enclosure_capacity
    before update
    on Enclosure
    for each row
BEGIN
    IF NEW.Capacity < 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Enclosure capacity cannot be negative';
    END IF;
    IF NEW.Animal_Count < 0 OR NEW.Animal_Count > NEW.Capacity THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Enclosure capacity cannot be below its current animal count';
    END IF;
END;

