    Quantity          decimal(10, 2)                                                         not null,
    Unit_Cost         decimal(10, 2)                                                         null,
    Total_Cost        decimal(12, 2) as ((`Quantity` * `Unit_Cost`)) stored,
    Order_Date        date                                               default (curdate()) not null,
    Expected_Delivery date                                                                   null,
    Received_Date     date                                                                   null,
    Status            enum ('Draft', 'Ordered', 'Received', 'Cancelled') default 'Draft'     not null,
    Auto_Generated    tinyint(1)                                         default 0           not null,
    constraint fk_po_feed
        foreign key (Feed_ID) references Feed (Feed_ID),
    constraint fk_po_product
        foreign key (Product_ID) references Product (Product_ID),
    constraint fk_po_supplier
        foreign key (Supplier_ID) references Supplier (Supplier_ID)
            on update cascade on delete set null,
    constraint chk_po_one_item
        check ((`Feed_ID` is null) <> (`Product_ID` is null)),
    constraint chk_po_quantity
        check (`Quantity` > 0)
);

