    on Animal (Species_ID);

create definer = avnadmin@`%` trigger animal_added
    after insert
    on Animal
    for each row
BEGIN
    UPDATE Enclosure SET Animal_Count = Animal_Count + 1 WHERE Enclosure_ID = NEW.Enclosure_ID AND Animal_Count < Capacity;
    IF ROW_COUNT() <> 1 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Enclosure is full or does not exist';
    END IF;
END;

create definer = avnadmin@`%` trigger animal_deleted
    after delete
    on Animal
    for each row
BEGIN
    UPDATE Enclosure SET Animal_Count = Animal_Count - 1 WHERE Enclosure_ID = OLD.Enclosure_ID AND Animal_Count > 0;
    IF ROW_COUNT() <> 1 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Enclosure occupancy is inconsistent';
    END IF;
END;

create definer = avnadmin@`%` trigger animal_moved
    after update
    on Animal
    for each row
BEGIN
    IF NEW.Enclosure_ID <> OLD.Enclosure_ID THEN
        UPDATE Enclosure SET Animal_Count = Animal_Count + 1 WHERE Enclosure_ID = NEW.Enclosure_ID AND Animal_Count < Capacity;
        IF ROW_COUNT() <> 1 THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Destination enclosure is full or does not exist';
        END IF;
        UPDATE Enclosure SET Animal_Count = Animal_Count - 1 WHERE Enclosure_ID = OLD.Enclosure_ID AND Animal_Count > 0;
        IF ROW_COUNT() <> 1 THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Original enclosure occupancy is inconsistent';
        END IF;
    END IF;
END;

create definer = avnadmin@`%` trigger trg_animal_relocation
    before update
    on Animal
    for each row
BEGIN
    IF NOT (NEW.Enclosure_ID <=> OLD.Enclosure_ID) THEN
        IF EXISTS (SELECT 1 FROM Enclosure WHERE Enclosure_ID = NEW.Enclosure_ID AND Status <> 'Open') THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Cannot move an animal into a closed enclosure';
        END IF;

        IF OLD.Needs_Relocation = 1 THEN
            SET NEW.Needs_Relocation = 0;
            UPDATE Care_Task
            SET Status = 'Completed', Completed_At = NOW()
            WHERE Animal_ID = NEW.Animal_ID AND Task_Category = 'Relocation'
              AND Status IN ('Open', 'In Progress');
        END IF;
    END IF;
END;

create definer = avnadmin@`%` trigger trg_auto_feeding_schedule
    after insert
    on Animal
    for each row
BEGIN
    IF NEW.Is_Active = 1 AND NEW.Breeding_ID IS NULL THEN
        INSERT INTO Feeding_Schedule (Animal_ID, Feed_ID, Keeper_Employee_ID, Feeding_Time, Quantity, Unit,
                                      Special_Instructions)
        SELECT NEW.Animal_ID, sf.Feed_ID,
               (SELECT ke.Employee_ID FROM Keeper_Enclosure ke
                WHERE ke.Enclosure_ID = NEW.Enclosure_ID
                  AND (ke.Assignment_End_Date IS NULL OR ke.Assignment_End_Date >= CURDATE())
                ORDER BY ke.Assignment_Start_Date, ke.Employee_ID LIMIT 1),
               '09:00:00', sf.Daily_Quantity, f.Unit,
               'Auto-created from species diet plan; adjust time and amount as needed.'
        FROM Species_Feed sf
                 JOIN Feed f ON f.Feed_ID = sf.Feed_ID
        WHERE sf.Species_ID = NEW.Species_ID
          AND sf.Daily_Quantity IS NOT NULL;
    END IF;
END;

create definer = avnadmin@`%` trigger trg_offspring_born
    after insert
    on Animal
    for each row
BEGIN
    DECLARE v_program INT DEFAULT NULL;
    DECLARE v_dam_name VARCHAR(100) DEFAULT NULL;
    DECLARE v_sire_name VARCHAR(100) DEFAULT NULL;
    DECLARE v_born DATE;
    DECLARE v_vet INT;

    IF NEW.Breeding_ID IS NOT NULL THEN
        SET v_born = COALESCE(NEW.Date_of_Birth, CURDATE());
        SET v_vet = fn_vet_for_animal(NEW.Mother_ID);  -- mother's vet takes the newborn

        SET v_program = (SELECT Program_ID FROM Breeding_Event WHERE Breeding_ID = NEW.Breeding_ID);
        IF v_program IS NULL THEN
            SET v_program = (SELECT Program_ID FROM Conservation_Program
                             WHERE Species_ID = NEW.Species_ID AND Status = 'Active'
                             ORDER BY Start_Date LIMIT 1);
        END IF;

        SET v_dam_name = (SELECT Animal_Name FROM Animal WHERE Animal_ID = NEW.Mother_ID);
        SET v_sire_name = (SELECT Animal_Name FROM Animal WHERE Animal_ID = NEW.Father_ID);

        UPDATE Breeding_Event
        SET Outcome = 'Offspring Born',
            Outcome_Date = COALESCE(Outcome_Date, v_born),
            Offspring_Count = Offspring_Count + 1
        WHERE Breeding_ID = NEW.Breeding_ID;

        INSERT INTO Conservation_Record (Animal_ID, Program_ID, Breeding_ID, Enrollment_Date, Status, Genetic_Notes)
        VALUES (NEW.Animal_ID, v_program, NEW.Breeding_ID, CURDATE(), 'Enrolled',
                CONCAT('Dam: ', COALESCE(v_dam_name, 'unknown'), '; Sire: ', COALESCE(v_sire_name, 'unknown')));

        IF v_vet IS NOT NULL THEN
            INSERT INTO Animal_Employee (Employee_ID, Animal_ID, Assigned_Role)
            VALUES (v_vet, NEW.Animal_ID, 'Primary Vet');
        END IF;

        INSERT INTO Care_Task (Animal_ID, Enclosure_ID, Task_Category, Title, Description, Priority,
                               Assigned_Employee_ID, Due_At, Source_Type, Source_ID)
        VALUES (NEW.Animal_ID, NEW.Enclosure_ID, 'Veterinary', CONCAT('Neonatal exam (24 h): ', NEW.Animal_Name),
                'Weight, hydration, nursing check, sex determination.', 'Urgent', v_vet,
                v_born + INTERVAL 1 DAY, 'Breeding_Event', NEW.Breeding_ID),
               (NEW.Animal_ID, NEW.Enclosure_ID, 'Veterinary', CONCAT('2-week wellness exam: ', NEW.Animal_Name),
                'Growth check against species norms; parasite screen.', 'High', v_vet,
                v_born + INTERVAL 14 DAY, 'Breeding_Event', NEW.Breeding_ID),
               (NEW.Animal_ID, NEW.Enclosure_ID, 'Veterinary', CONCAT('6-week exam and vaccinations: ', NEW.Animal_Name),
                'First vaccination series and microchip.', 'Normal', v_vet,
                v_born + INTERVAL 42 DAY, 'Breeding_Event', NEW.Breeding_ID),
               (NEW.Animal_ID, NEW.Enclosure_ID, 'Conservation', CONCAT('Register birth in studbook: ', NEW.Animal_Name),
                'Submit birth and parentage to the program studbook keeper; record Studbook_Number.', 'Normal', NULL,
                v_born + INTERVAL 30 DAY, 'Breeding_Event', NEW.Breeding_ID);

        CALL sp_notify_enclosure_keepers(NEW.Enclosure_ID, NEW.Animal_ID, 'Important',
                                         CONCAT('New birth: ', NEW.Animal_Name, ' (dam ', COALESCE(v_dam_name, 'unknown'),
                                                '). Monitor nursing and keep public away from the den area.'));
    END IF;
END;

create definer = avnadmin@`%` trigger trg_offspring_lineage
    before insert
    on Animal
    for each row
BEGIN
    DECLARE v_dam INT;
    DECLARE v_sire INT;
    DECLARE v_outcome VARCHAR(20);

    IF NEW.Breeding_ID IS NOT NULL THEN
        SELECT Dam_ID, Sire_ID, Outcome INTO v_dam, v_sire, v_outcome
        FROM Breeding_Event WHERE Breeding_ID = NEW.Breeding_ID;

        IF v_outcome = 'Unsuccessful' THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'This breeding event is marked unsuccessful';
        END IF;

        SET NEW.Mother_ID = COALESCE(NEW.Mother_ID, v_dam);
        SET NEW.Father_ID = COALESCE(NEW.Father_ID, v_sire);
        SET NEW.Acquisition_Type = COALESCE(NEW.Acquisition_Type, 'Born at Zoo');
        SET NEW.Date_Acquired = COALESCE(NEW.Date_Acquired, NEW.Date_of_Birth, CURDATE());
    END IF;
END;

