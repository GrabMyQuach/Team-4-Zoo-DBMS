create definer = avnadmin@`%` trigger trg_inspection_result
    after insert
    on Habitat_Inspection
    for each row
BEGIN
    DECLARE v_enc_name VARCHAR(100);
    DECLARE v_location VARCHAR(100);

    SELECT Enclosure_Name, Location INTO v_enc_name, v_location
    FROM Enclosure WHERE Enclosure_ID = NEW.Enclosure_ID;

    IF NEW.Result = 'Critical' THEN
        INSERT INTO Maintenance (Description, Location, Request_Date, Status, Enclosure_ID, Priority, Inspection_ID)
        VALUES (CONCAT('EMERGENCY - ', NEW.Issue_Category, ': ', COALESCE(NEW.Findings, 'see inspection')),
                v_location, DATE(NEW.Inspection_Date), 'Open', NEW.Enclosure_ID, 'Emergency', NEW.Inspection_ID);

        UPDATE Enclosure
        SET Status = 'Closed',
            Closed_Reason = CONCAT('Critical inspection #', NEW.Inspection_ID, ' (', NEW.Issue_Category, ')'),
            Status_Changed_At = NOW()
        WHERE Enclosure_ID = NEW.Enclosure_ID;

        UPDATE Animal SET Needs_Relocation = 1
        WHERE Enclosure_ID = NEW.Enclosure_ID AND Is_Active = 1;

        INSERT INTO Care_Task (Animal_ID, Enclosure_ID, Task_Category, Title, Description, Priority,
                               Due_At, Source_Type, Source_ID)
        SELECT a.Animal_ID, a.Enclosure_ID, 'Relocation',
               CONCAT('Relocate ', a.Animal_Name, ' out of ', v_enc_name),
               CONCAT('Enclosure closed: ', NEW.Issue_Category, '. ', COALESCE(NEW.Findings, '')),
               'Urgent', NEW.Inspection_Date + INTERVAL 4 HOUR, 'Habitat_Inspection', NEW.Inspection_ID
        FROM Animal a
        WHERE a.Enclosure_ID = NEW.Enclosure_ID
          AND a.Is_Active = 1
          AND NOT EXISTS (SELECT 1 FROM Care_Task t
                          WHERE t.Animal_ID = a.Animal_ID AND t.Task_Category = 'Relocation'
                            AND t.Status IN ('Open', 'In Progress'));

        CALL sp_notify_enclosure_keepers(NEW.Enclosure_ID, NULL, 'Urgent',
                                         CONCAT(v_enc_name, ' is CLOSED after a critical inspection (', NEW.Issue_Category,
                                                '). Move all animals to safe holding now.'));

    ELSEIF NEW.Result = 'Pass' THEN
        IF EXISTS (SELECT 1 FROM Enclosure WHERE Enclosure_ID = NEW.Enclosure_ID AND Status = 'Closed')
            AND NOT EXISTS (SELECT 1 FROM Maintenance
                            WHERE Enclosure_ID = NEW.Enclosure_ID AND Priority = 'Emergency'
                              AND NOT (Status <=> 'Completed')) THEN

            UPDATE Enclosure
            SET Status = 'Open', Closed_Reason = NULL, Status_Changed_At = NOW()
            WHERE Enclosure_ID = NEW.Enclosure_ID;

            UPDATE Animal SET Needs_Relocation = 0
            WHERE Enclosure_ID = NEW.Enclosure_ID AND Needs_Relocation = 1;

            UPDATE Care_Task
            SET Status = 'Cancelled', Completed_At = NOW()
            WHERE Enclosure_ID = NEW.Enclosure_ID AND Task_Category = 'Relocation'
              AND Status IN ('Open', 'In Progress');

            UPDATE Care_Task
            SET Status = 'Completed', Completed_At = NOW()
            WHERE Enclosure_ID = NEW.Enclosure_ID AND Task_Category = 'Inspection'
              AND Status IN ('Open', 'In Progress');

            CALL sp_notify_enclosure_keepers(NEW.Enclosure_ID, NULL, 'Info',
                                             CONCAT(v_enc_name, ' passed re-inspection and is open again.'));
        END IF;
    END IF;
END;

