create definer = avnadmin@`%` trigger trg_contagious_diagnosis
    after insert
    on Health_Record
    for each row
BEGIN
    DECLARE v_name VARCHAR(100);
    DECLARE v_enclosure INT;
    DECLARE v_disease VARCHAR(255);
    DECLARE v_vet INT;

    IF NEW.Is_Contagious = 1 THEN
        SET v_disease = COALESCE(NEW.Diagnosis, 'a contagious condition');
        SET v_vet = COALESCE(NEW.Vet_Employee_ID, fn_vet_for_animal(NEW.Animal_ID));

        SELECT Animal_Name, Enclosure_ID INTO v_name, v_enclosure
        FROM Animal WHERE Animal_ID = NEW.Animal_ID;

        IF NOT EXISTS (SELECT 1 FROM Quarantine
                       WHERE Animal_ID = NEW.Animal_ID AND Status IN ('Active', 'Extended')) THEN
            INSERT INTO Quarantine (Animal_ID, Health_Record_ID, Start_Date, Expected_End_Date, Reason, Status)
            VALUES (NEW.Animal_ID, NEW.Health_Record_ID, DATE(NEW.Exam_Date),
                    DATE(NEW.Exam_Date) + INTERVAL 14 DAY, CONCAT('Contagious: ', v_disease), 'Active');
        END IF;

        UPDATE Animal
        SET Public_Encounter_Eligible = 0, Health_Status = 'Quarantined'
        WHERE Animal_ID = NEW.Animal_ID;

        -- Tell handlers, then cancel the animal's upcoming public encounters
        INSERT INTO Staff_Notification (Employee_ID, Animal_ID, Priority, Message)
        SELECT ae.Handler_Employee_ID, NEW.Animal_ID, 'Important',
               CONCAT(COUNT(*), ' upcoming encounter(s) with ', v_name, ' cancelled: animal quarantined.')
        FROM Animal_Encounter ae
        WHERE ae.Animal_ID = NEW.Animal_ID AND ae.Status = 'Scheduled'
          AND ae.Scheduled_Start >= NOW() AND ae.Handler_Employee_ID IS NOT NULL
        GROUP BY ae.Handler_Employee_ID;

        UPDATE Animal_Encounter
        SET Status = 'Cancelled', Cancel_Reason = CONCAT('Quarantine: ', v_disease)
        WHERE Animal_ID = NEW.Animal_ID AND Status = 'Scheduled' AND Scheduled_Start >= NOW();

        INSERT INTO Care_Task (Animal_ID, Enclosure_ID, Task_Category, Title, Description, Priority,
                               Assigned_Employee_ID, Due_At, Source_Type, Source_ID)
        VALUES (NEW.Animal_ID, v_enclosure, 'Veterinary',
                CONCAT('Quarantine follow-up: ', v_name),
                CONCAT('Re-examine for ', v_disease, '; decide whether to release or extend quarantine.'),
                IF(NEW.Severity IN ('High', 'Critical'), 'Urgent', 'High'), v_vet,
                NEW.Exam_Date + INTERVAL IF(NEW.Severity IN ('High', 'Critical'), 1, 3) DAY,
                'Health_Record', NEW.Health_Record_ID);

        INSERT INTO Care_Task (Animal_ID, Enclosure_ID, Task_Category, Title, Description, Priority,
                               Assigned_Employee_ID, Due_At, Source_Type, Source_ID)
        SELECT a.Animal_ID, v_enclosure, 'Veterinary',
               CONCAT('Exposure screening: ', a.Animal_Name),
               CONCAT('Shares an enclosure with ', v_name, ', diagnosed with ', v_disease, '.'),
               'High', COALESCE(fn_primary_vet(a.Animal_ID), v_vet),
               NEW.Exam_Date + INTERVAL 2 DAY, 'Health_Record', NEW.Health_Record_ID
        FROM Animal a
        WHERE a.Enclosure_ID = v_enclosure
          AND a.Animal_ID <> NEW.Animal_ID
          AND a.Is_Active = 1;

        CALL sp_notify_enclosure_keepers(v_enclosure, NEW.Animal_ID, 'Urgent',
                                         CONCAT(v_name, ' is quarantined for ', v_disease,
                                                '. Removed from public encounters. Use PPE and keep separated from enclosure-mates.'));
    END IF;
END;

create table Quarantine
(
    Quarantine_ID     int auto_increment
        primary key,
    Animal_ID         int                                                      not null,
    Health_Record_ID  int                                                      null,
    Start_Date        date                                                     not null,
    Expected_End_Date date                                                     null,
    Actual_End_Date   date                                                     null,
    Reason            varchar(255)                                             null,
    Status            enum ('Active', 'Extended', 'Released') default 'Active' not null,
    constraint fk_quarantine_animal
        foreign key (Animal_ID) references Animal (Animal_ID)
            on update cascade on delete cascade,
    constraint fk_quarantine_record
        foreign key (Health_Record_ID) references Health_Record (Health_Record_ID)
            on delete set null
);

create index idx_quarantine_status
    on Quarantine (Animal_ID, Status);

create definer = avnadmin@`%` trigger trg_quarantine_released
    before update
    on Quarantine
    for each row
BEGIN
    IF NEW.Status = 'Released' AND NOT (OLD.Status <=> 'Released') THEN
        SET NEW.Actual_End_Date = COALESCE(NEW.Actual_End_Date, CURDATE());

        IF NOT EXISTS (SELECT 1 FROM Quarantine
                       WHERE Animal_ID = NEW.Animal_ID
                         AND Quarantine_ID <> NEW.Quarantine_ID
                         AND Status IN ('Active', 'Extended')) THEN
            UPDATE Animal
            SET Public_Encounter_Eligible = 1, Health_Status = 'Recovered'
            WHERE Animal_ID = NEW.Animal_ID;

            UPDATE Care_Task
            SET Status = 'Cancelled', Completed_At = NOW()
            WHERE Animal_ID = NEW.Animal_ID
              AND Source_Type = 'Health_Record'
              AND Source_ID = NEW.Health_Record_ID
              AND Status IN ('Open', 'In Progress');

            CALL sp_notify_enclosure_keepers(
                    (SELECT Enclosure_ID FROM Animal WHERE Animal_ID = NEW.Animal_ID), NEW.Animal_ID, 'Info',
                    CONCAT((SELECT Animal_Name FROM Animal WHERE Animal_ID = NEW.Animal_ID),
                           ' has been released from quarantine and may return to public encounters.'));
        END IF;
    END IF;
END;

