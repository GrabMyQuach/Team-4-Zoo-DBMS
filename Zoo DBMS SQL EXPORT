create definer = avnadmin@`%` trigger trg_purchase_received
    before update
    on Purchase_Order
    for each row
BEGIN
    IF NEW.Status = 'Received' AND NOT (OLD.Status <=> 'Received') THEN
        SET NEW.Received_Date = COALESCE(NEW.Received_Date, CURDATE());

        IF NEW.Feed_ID IS NOT NULL THEN
            UPDATE Feed
            SET Quantity_In_Stock = COALESCE(Quantity_In_Stock, 0) + NEW.Quantity,
                Unit_Cost = COALESCE(NEW.Unit_Cost, Unit_Cost)
            WHERE Feed_ID = NEW.Feed_ID;
        ELSE
            UPDATE Inventory
            SET Quantity_In_Stock = Quantity_In_Stock + NEW.Quantity, Last_Updated = NOW()
            WHERE Product_ID = NEW.Product_ID;
        END IF;

        UPDATE Care_Task
        SET Status = 'Completed', Completed_At = NOW()
        WHERE Source_Type = 'Purchase_Order' AND Source_ID = NEW.PO_ID
          AND Status IN ('Open', 'In Progress');
    END IF;
END;

