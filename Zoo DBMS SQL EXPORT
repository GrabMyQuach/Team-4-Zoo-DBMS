create definer = avnadmin@`%` trigger ticket_item_added
    after insert
    on Ticket_Purchase_Item
    for each row
BEGIN
    IF NEW.Quantity IS NULL OR NEW.Quantity <= 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Quantity must be greater than zero';
    END IF;
    IF NEW.Unit_Price IS NULL OR NEW.Unit_Price < 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Unit price must be zero or greater';
    END IF;
    UPDATE Ticket_Sale SET Total_Amount = Total_Amount + NEW.Quantity * NEW.Unit_Price WHERE TicketPurchase_ID = NEW.TicketPurchase_ID;
END;

create definer = avnadmin@`%` trigger ticket_item_deleted
    after delete
    on Ticket_Purchase_Item
    for each row
BEGIN
    UPDATE Ticket_Sale SET Total_Amount = Total_Amount - OLD.Quantity * OLD.Unit_Price WHERE TicketPurchase_ID = OLD.TicketPurchase_ID;
END;

create definer = avnadmin@`%` trigger ticket_item_updated
    after update
    on Ticket_Purchase_Item
    for each row
BEGIN
    IF NEW.Quantity IS NULL OR NEW.Quantity <= 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Quantity must be greater than zero';
    END IF;
    IF NEW.Unit_Price IS NULL OR NEW.Unit_Price < 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Unit price must be zero or greater';
    END IF;
    IF NEW.TicketPurchase_ID <> OLD.TicketPurchase_ID OR NEW.TicketType_ID <> OLD.TicketType_ID THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Only ticket quantity and unit price can be edited';
    END IF;
    UPDATE Ticket_Sale SET Total_Amount = Total_Amount - OLD.Quantity * OLD.Unit_Price + NEW.Quantity * NEW.Unit_Price WHERE TicketPurchase_ID = NEW.TicketPurchase_ID;
END;

