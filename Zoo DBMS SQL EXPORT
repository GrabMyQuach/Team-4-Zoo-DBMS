    Enclosure_ID              int                  not null,
    Date_Acquired             date                 null,
    Acquisition_Type          varchar(100)         null,
    Is_Active                 tinyint(1) default 1 not null,
    Public_Encounter_Eligible tinyint(1) default 1 not null,
