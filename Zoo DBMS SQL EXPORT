create definer = avnadmin@`%` trigger sale_item_added
    after insert
    on Sale_Item
    for each row
BEGIN
    IF NEW.Quantity IS NULL OR NEW.Quantity <= 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Quantity must be greater than zero';
    END IF;
    IF NEW.Unit_Price IS NULL OR NEW.Unit_Price < 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Unit price must be zero or greater';
    END IF;
    IF (NEW.Product_ID IS NULL) = (NEW.FoodItem_ID IS NULL) THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Choose exactly one Product_ID or FoodItem_ID';
    END IF;
    IF NEW.Product_ID IS NOT NULL THEN
        IF NOT EXISTS (SELECT 1 FROM Sale s JOIN Product p ON p.GiftShop_ID = s.GiftShop_ID WHERE s.Sale_ID = NEW.Sale_ID AND p.Product_ID = NEW.Product_ID AND s.Sale_Type = 'GiftShop' AND s.Stand_ID IS NULL FOR SHARE) THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Product must belong to the gift shop on this sale';
        END IF;
        UPDATE Inventory SET Quantity_In_Stock = Quantity_In_Stock - NEW.Quantity, Last_Updated = CURRENT_TIMESTAMP WHERE Product_ID = NEW.Product_ID AND Quantity_In_Stock >= NEW.Quantity;
        IF ROW_COUNT() <> 1 THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Insufficient stock or missing inventory record';
        END IF;
    END IF;
    IF NEW.FoodItem_ID IS NOT NULL THEN
        IF NOT EXISTS (SELECT 1 FROM Sale s JOIN Food_Item f ON f.Stand_ID = s.Stand_ID WHERE s.Sale_ID = NEW.Sale_ID AND f.FoodItem_ID = NEW.FoodItem_ID AND s.Sale_Type = 'Food' AND s.GiftShop_ID IS NULL FOR SHARE) THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Food item must belong to the food stand on this sale';
        END IF;
    END IF;
    UPDATE Sale SET Total_Amount = Total_Amount + NEW.Quantity * NEW.Unit_Price WHERE Sale_ID = NEW.Sale_ID;
END;

create definer = avnadmin@`%` trigger sale_item_deleted
    after delete
    on Sale_Item
    for each row
BEGIN
    IF OLD.Product_ID IS NOT NULL THEN
        UPDATE Inventory SET Quantity_In_Stock = Quantity_In_Stock + OLD.Quantity, Last_Updated = CURRENT_TIMESTAMP WHERE Product_ID = OLD.Product_ID;
        IF ROW_COUNT() <> 1 THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Cannot restore stock: missing inventory record';
        END IF;
    END IF;
    UPDATE Sale SET Total_Amount = Total_Amount - OLD.Quantity * OLD.Unit_Price WHERE Sale_ID = OLD.Sale_ID;
END;

create definer = avnadmin@`%` trigger sale_item_updated
    after update
    on Sale_Item
    for each row
BEGIN
    IF NEW.Quantity IS NULL OR NEW.Quantity <= 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Quantity must be greater than zero';
    END IF;
    IF NEW.Unit_Price IS NULL OR NEW.Unit_Price < 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Unit price must be zero or greater';
    END IF;
    IF NEW.SaleItem_ID <> OLD.SaleItem_ID OR NEW.Sale_ID <> OLD.Sale_ID OR NOT (NEW.Product_ID <=> OLD.Product_ID) OR NOT (NEW.FoodItem_ID <=> OLD.FoodItem_ID) THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Only quantity and unit price can be edited; delete and reinsert to change the item';
    END IF;
    IF NEW.Product_ID IS NOT NULL THEN
        IF NOT EXISTS (SELECT 1 FROM Sale s JOIN Product p ON p.GiftShop_ID = s.GiftShop_ID WHERE s.Sale_ID = NEW.Sale_ID AND p.Product_ID = NEW.Product_ID AND s.Sale_Type = 'GiftShop' AND s.Stand_ID IS NULL FOR SHARE) THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Product must belong to the gift shop on this sale';
        END IF;
    END IF;
    IF NEW.FoodItem_ID IS NOT NULL THEN
        IF NOT EXISTS (SELECT 1 FROM Sale s JOIN Food_Item f ON f.Stand_ID = s.Stand_ID WHERE s.Sale_ID = NEW.Sale_ID AND f.FoodItem_ID = NEW.FoodItem_ID AND s.Sale_Type = 'Food' AND s.GiftShop_ID IS NULL FOR SHARE) THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Food item must belong to the food stand on this sale';
        END IF;
    END IF;
    IF NEW.Product_ID IS NOT NULL AND NEW.Quantity <> OLD.Quantity THEN
        UPDATE Inventory SET Quantity_In_Stock = Quantity_In_Stock - (NEW.Quantity - OLD.Quantity), Last_Updated = CURRENT_TIMESTAMP WHERE Product_ID = NEW.Product_ID AND Quantity_In_Stock >= GREATEST(NEW.Quantity - OLD.Quantity, 0);
        IF ROW_COUNT() <> 1 THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Insufficient stock or missing inventory record';
        END IF;
    END IF;
    UPDATE Sale SET Total_Amount = Total_Amount - OLD.Quantity * OLD.Unit_Price + NEW.Quantity * NEW.Unit_Price WHERE Sale_ID = NEW.Sale_ID;
END;

