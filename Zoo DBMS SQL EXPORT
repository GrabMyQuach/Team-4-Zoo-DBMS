create definer = avnadmin@`%` trigger trg_shift_absent_insert
    after insert
    on Employee_Shift
    for each row
BEGIN
    IF NEW.Status = 'Absent' THEN
        CALL sp_reassign_for_absence(NEW.Employee_ID, NEW.Shift_Date,
                                     COALESCE(NEW.Department_ID, (SELECT Department_ID FROM Employee WHERE Employee_ID = NEW.Employee_ID)));
    END IF;
END;

create definer = avnadmin@`%` trigger trg_shift_absent_update
    after update
    on Employee_Shift
    for each row
BEGIN
    IF NEW.Status = 'Absent' AND NOT (OLD.Status <=> 'Absent') THEN
        CALL sp_reassign_for_absence(NEW.Employee_ID, NEW.Shift_Date,
                                     COALESCE(NEW.Department_ID, (SELECT Department_ID FROM Employee WHERE Employee_ID = NEW.Employee_ID)));
    END IF;
END;

