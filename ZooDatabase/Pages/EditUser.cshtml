@page
@model EditUserModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">Edit User: @Model.Username</h1>
</div>

<div class="card" style="max-width: 560px;">
    <div class="card-body p-4">

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }

        @if (Model.IsSelf)
        {
            <div class="alert alert-info py-2">This is your own account.</div>
        }

        <form method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Role</label>
                <select asp-for="Role" class="form-select">
                    @foreach (var r in AddUserModel.Roles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>

            <div class="form-check form-switch mb-4">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label">Account is active</label>
                <div class="form-text">Turn off to stop this user from logging in.</div>
            </div>

            <h2 class="h6 fw-semibold border-top pt-3">Reset Password <span class="text-muted fw-normal">(optional)</span></h2>
            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control" />
                <div class="form-text">Leave blank to keep their current password.</div>
            </div>
            <div class="mb-4">
                <label class="form-label">Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                <a asp-page="/ManageUsers" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>