@page
@model LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in - Zoo Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f4f6f5; min-height: 100vh; display: flex; flex-direction: column; }
        .login-wrap { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px 16px; }
        .login-card { background: #fff; border: 1px solid #e3e7e5; border-radius: 16px; padding: 48px 40px;
                      width: 100%; max-width: 440px; box-shadow: 0 4px 24px rgba(0,0,0,.05); }
        .brand { text-align: center; margin-bottom: 32px; }
        .brand-icon { font-size: 56px; line-height: 1; }
        .brand-name { font-size: 28px; font-weight: 700; color: #1f5f3f; margin-top: 8px; }
        .brand-sub { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: #8a948f; }
        .form-control { padding: 12px 14px; border-radius: 8px; }
        .btn-zoo { background: #1f5f3f; color: #fff; border-radius: 999px; padding: 12px; font-weight: 600; }
        .btn-zoo:hover { background: #174a31; color: #fff; }
        .footer-note { text-align: center; font-size: 13px; color: #6c757d; padding: 16px; }
        .brand-logo { width: 100%; max-width: 280px; height: auto; }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">
            <div class="brand">
                <img src="~/images/zoo-logo.jpg" alt="Zoo logo" class="brand-logo" />
                <div class="brand-name">Zoo Management</div>
                <div class="brand-sub">Staff Portal</div>
            </div>

            <h5 class="mb-3 fw-semibold">Sign in to your account</h5>

            @if (Model.ErrorMessage != null)
            {
                <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <input asp-for="Username" class="form-control" placeholder="Username" autocomplete="username" />
                </div>
                <div class="mb-4">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" autocomplete="current-password" />
                </div>
                <button type="submit" class="btn btn-zoo w-100">Log in</button>
            </form>
        </div>
    </div>

    <div class="footer-note">
        This system is for authorized zoo staff only. Unauthorized use is prohibited.<br />
        © 2026 Team 4 Zoo Management System
    </div>
</body>
</html>