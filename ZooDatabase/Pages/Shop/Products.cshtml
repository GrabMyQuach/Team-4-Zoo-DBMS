@page
@model ZooDatabase.Pages.Shop.ProductsModel
@{
    ViewData["Title"] = "Products";
    bool filtered = Model.ShopId != null || !string.IsNullOrEmpty(Model.Category) || !string.IsNullOrWhiteSpace(Model.Search);
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">Products</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">@Model.Rows.Count products · @Model.Rows.Sum(r => r.Revenue30).ToString("C0") sold in 30 days</h2>
    @if (Model.CanManage)
    {
        <a href="/Shop/ProductEdit" class="btn btn-primary rounded-pill px-4">+ Add Product</a>
    }
</div>

<div class="card">
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4"><input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Search product" /></div>
            <div class="col-md-3">
                <select name="ShopId" class="form-select">
                    <option value="">All gift shops</option>
                    @foreach (var s in Model.Shops)
                    {
                        <option value="@s.Id" selected="@(Model.ShopId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="Category" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c" selected="@(Model.Category == c)">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-secondary rounded-pill px-3">Filter</button>
                @if (filtered)
                {
                    <a href="/Shop/Products" class="btn btn-link px-1">Clear</a>
                }
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Product</th><th>Shop</th><th class="text-end">Price</th><th class="text-end">Cost</th><th class="text-end">Margin</th><th class="text-end">In Stock</th><th class="text-end">Sold, 30 Days</th><th class="text-end">Revenue, 30 Days</th><th class="text-end">Profit, 30 Days</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Rows)
                {
                    <tr class="clickable-row" onclick="location.href='/Shop/ProductDetails/@p.Id'">
                        <td><span class="fw-semibold">@p.Name</span><div class="small text-muted">@p.Category</div></td>
                        <td>@p.Shop</td>
                        <td class="text-end">@p.Price.ToString("C")</td>
                        <td class="text-end">@(p.Cost?.ToString("C") ?? "—")</td>
                        <td class="text-end">@(p.MarginPct == null ? "—" : p.MarginPct + "%")</td>
                        <td class="text-end @(p.LowStock ? "text-danger fw-semibold" : "")">@(p.Stock?.ToString() ?? "—")</td>
                        <td class="text-end">@p.Sold30</td>
                        <td class="text-end fw-semibold">@p.Revenue30.ToString("C0")</td>
                        <td class="text-end">@(p.Profit30?.ToString("C0") ?? "—")</td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No products found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
