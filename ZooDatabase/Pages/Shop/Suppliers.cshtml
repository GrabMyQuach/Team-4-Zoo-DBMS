@page
@model ZooDatabase.Pages.Shop.SuppliersModel
@{
    ViewData["Title"] = "Suppliers";
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">Suppliers</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">@Model.Rows.Count suppliers · @Model.Rows.Sum(r => r.Spend90).ToString("C0") spent in 90 days</h2>
    @if (Model.CanManage)
    {
        <a href="/Shop/SupplierEdit" class="btn btn-primary rounded-pill px-4">+ Add Supplier</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Supplier</th><th>Contact</th><th>Delivers</th><th class="text-end">Products</th><th class="text-end">Feeds</th><th class="text-end">Open Orders</th><th class="text-end">Spend, 90 Days</th><th class="text-end">On Time</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Rows)
                {
                    <tr class="@(Model.CanManage ? "clickable-row" : "") @(s.OnTimePct < 80 ? "table-warning" : "")"
                        onclick="@(Model.CanManage ? $"location.href='/Shop/SupplierEdit/{s.Id}'" : "")">
                        <td class="fw-semibold">@s.Name</td>
                        <td>@s.Email<div class="small text-muted">@s.Phone</div></td>
                        <td class="small">@s.Delivery</td>
                        <td class="text-end">@s.Products</td>
                        <td class="text-end">@s.Feeds</td>
                        <td class="text-end">@s.OpenOrders</td>
                        <td class="text-end fw-semibold">@s.Spend90.ToString("C0")</td>
                        <td class="text-end">@(s.OnTimePct == null ? "—" : s.OnTimePct + "%")<div class="small text-muted">@s.Delivered deliveries</div></td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No suppliers yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
