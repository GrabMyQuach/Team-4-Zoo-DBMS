@model ZooDatabase.Pages.Shop.OutletDetailsModel
@using ZooDatabase.Pages.Shop
@{
    var k = Model.Kind;
    var o = Model.Outlet;
    ViewData["Title"] = o.Name;
    var maxHour = Model.ByHour.Count == 0 ? 1m : Math.Max(1m, Model.ByHour.Max(h => h.Revenue));
    bool isFood = k == OutletKind.Food;
}

<a href="@(isFood ? "/Shop/FoodStands" : "/Shop/GiftShops")" class="back-link mt-0 mb-3 d-inline-block">← All @k.Plural.ToLower()</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="border-bottom pb-3 mb-4 d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1 class="h2 mb-1">@o.Name</h1>
        <div class="text-muted">@(o.Category ?? k.Label)@(o.Location == null ? "" : " · " + o.Location) · @o.Hours</div>
        @if (Model.Description != null)
        {
            <div class="small text-muted mt-1">@Model.Description</div>
        }
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanSell)
        {
            <a href="/Shop/SaleNew?type=@k.SaleType&outletId=@o.Id" class="btn btn-primary rounded-pill px-4">New Sale</a>
        }
        @if (Model.CanManage)
        {
            <a href="@(k.UrlBase)Edit/@o.Id" class="btn btn-outline-secondary rounded-pill px-4">Edit</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Revenue, 30 days</div>
            <div class="stat-value">@o.Revenue30.ToString("C0")</div>
            @if (o.ChangePct != null)
            {
                <div class="small @(o.ChangePct < 0 ? "text-danger" : "text-success")">@(o.ChangePct > 0 ? "+" : "")@o.ChangePct% vs. previous 30 days</div>
            }
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Orders, 30 days</div>
            <div class="stat-value">@o.Orders30</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Average order</div>
            <div class="stat-value">@o.AvgOrder.ToString("C")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Not selling</div>
            <div class="stat-value @(Model.Items.Any(i => i.Sold30 == 0) ? "text-warning" : "")">@Model.Items.Count(i => i.Sold30 == 0)</div>
            <div class="small text-muted">of @Model.Items.Count items, last 30 days</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body pb-0"><h2 class="h5 section-heading">@(isFood ? "Menu Performance" : "Product Performance"), 30 Days</h2></div>
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Item</th><th class="text-end">Price</th><th class="text-end">Sold</th><th class="text-end">Revenue</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        var clickable = !isFood || Model.CanManage;
                        <tr class="@(clickable ? "clickable-row" : "") @(i.Sold30 == 0 ? "table-warning" : "")"
                            onclick="@(clickable ? $"location.href='{(isFood ? "/Shop/MenuItemEdit/" : "/Shop/ProductDetails/")}{i.Id}'" : "")">
                            <td><span class="fw-semibold">@i.Name</span><div class="small text-muted">@i.Category</div></td>
                            <td class="text-end">@i.Price.ToString("C")</td>
                            <td class="text-end">@i.Sold30</td>
                            <td class="text-end">@i.Revenue30.ToString("C0")</td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">No items yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Busiest Hours, 30 Days</h2></div>
            <table class="table table-sm align-middle mb-0">
                <tbody>
                    @foreach (var h in Model.ByHour)
                    {
                        <tr>
                            <td style="width: 70px;">@ShopText.HourLabel(h.Hour)</td>
                            <td><div class="mini-bar"><div class="mini-bar-fill" style="width: @((int)(h.Revenue * 100 / maxHour))%;"></div></div></td>
                            <td class="text-end small">@h.Orders orders</td>
                            <td class="text-end small">@h.Revenue.ToString("C0")</td>
                        </tr>
                    }
                    @if (Model.ByHour.Count == 0)
                    {
                        <tr><td class="text-center text-muted py-3">No sales in the last 30 days.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Recent Sales</h2></div>
            <table class="table table-hover align-middle mb-0">
                <tbody>
                    @foreach (var s in Model.RecentSales)
                    {
                        <tr class="clickable-row" onclick="location.href='/Shop/SaleDetails/@s.Id'">
                            <td class="small">@s.Date.ToString("MMM d, h:mm tt")</td>
                            <td class="small text-muted">@s.Items items · @s.Payment</td>
                            <td class="text-end fw-semibold">@s.Total.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
