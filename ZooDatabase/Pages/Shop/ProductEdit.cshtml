@page "{id:int?}"
@model ZooDatabase.Pages.Shop.ProductEditModel
@{
    string title = Model.IsNew ? "Add Product" : "Edit " + Model.Name;
    ViewData["Title"] = title;
    string cancelUrl = Model.IsNew ? "/Shop/Products" : $"/Shop/ProductDetails/{Model.Id}";
}

<a href="@cancelUrl" class="back-link mt-0 mb-3 d-inline-block">← Back</a>

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">@title</h1>
</div>

<div class="card" style="max-width: 720px;">
    <div class="card-body p-4">
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }
        <form method="post">
            <h2 class="h6 text-muted text-uppercase mb-3">Product</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Gift shop *</label>
                    <select name="ShopId" class="form-select">
                        <option value="0">Choose a gift shop…</option>
                        @foreach (var s in Model.Shops)
                        {
                            <option value="@s.Id" selected="@(Model.ShopId == s.Id)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Name *</label>
                    <input asp-for="Name" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Price *</label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Category</label>
                    <input asp-for="Category" class="form-control" maxlength="50" placeholder="e.g. Plush, Apparel, Souvenirs" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Description</label>
                    <input asp-for="Description" class="form-control" maxlength="255" />
                </div>
            </div>

            <h2 class="h6 text-muted text-uppercase mb-3">Stock</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Reorder when stock reaches</label>
                    <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                </div>
                @if (Model.IsNew)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Starting stock</label>
                        <input asp-for="StartingStock" type="number" min="0" class="form-control" />
                    </div>
                }
            </div>

            <h2 class="h6 text-muted text-uppercase mb-3">Supplier</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-7">
                    <label class="form-label fw-semibold">Supplier</label>
                    <select name="SupplierId" class="form-select">
                        <option value="0">@(Model.IsNew ? "None yet" : "Keep current suppliers")</option>
                        @foreach (var s in Model.Suppliers)
                        {
                            <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Our cost per unit</label>
                    <input asp-for="SupplierCost" type="number" step="0.01" min="0" class="form-control" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">@(Model.IsNew ? "Add Product" : "Save Changes")</button>
                <a href="@cancelUrl" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>
