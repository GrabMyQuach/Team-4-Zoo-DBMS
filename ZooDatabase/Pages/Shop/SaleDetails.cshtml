@page "{id:int}"
@model ZooDatabase.Pages.Shop.SaleDetailsModel
@{
    ViewData["Title"] = "Sale #" + Model.Id;
    bool isFood = Model.Type == "Food";
}

<a href="/Shop/Sales" class="back-link mt-0 mb-3 d-inline-block">← All sales</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-1">Sale #@Model.Id</h1>
    <div class="text-muted">
        @if (Model.OutletId != null)
        {
            <a href="/Shop/@(isFood ? "FoodStand" : "GiftShop")Details/@Model.OutletId">@Model.Place</a>
        }
        · @Model.Date.ToString("dddd, MMM d, yyyy h:mm tt")
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Items</h2></div>
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Price Each</th><th class="text-end">Line Total</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (isFood)
                                {
                                    @i.Name
                                }
                                else
                                {
                                    <a href="/Shop/ProductDetails/@i.ItemId">@i.Name</a>
                                }
                            </td>
                            <td class="text-end">@i.Qty</td>
                            <td class="text-end">@i.Price.ToString("C")</td>
                            <td class="text-end">@((i.Qty * i.Price).ToString("C"))</td>
                        </tr>
                    }
                    <tr class="table-light">
                        <td colspan="3" class="text-end fw-semibold">Total</td>
                        <td class="text-end fw-bold">@Model.Total.ToString("C")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h5 section-heading">Sale Info</h2>
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-5">Type</dt>
                    <dd class="col-sm-7">@(isFood ? "Food" : "Gift Shop")</dd>
                    <dt class="col-sm-5">Customer</dt>
                    <dd class="col-sm-7">
                        @if (Model.CustomerId != null)
                        {
                            <a href="/Tickets/CustomerDetails/@Model.CustomerId">@Model.Customer</a>
                        }
                        else
                        {
                            <span>Walk-in</span>
                        }
                    </dd>
                    <dt class="col-sm-5">Cashier</dt>
                    <dd class="col-sm-7">@(Model.Cashier ?? "—")</dd>
                    <dt class="col-sm-5">Payment</dt>
                    <dd class="col-sm-7">@(Model.Payment ?? "—")</dd>
                </dl>
            </div>
        </div>
        @if (Model.CanVoid)
        {
            <div class="card mt-3">
                <div class="card-body p-4">
                    <h2 class="h6 mb-1">Rung up by mistake?</h2>
                    <p class="text-muted small mb-3">Voiding removes this sale and its total from the reports@(isFood ? "" : " and puts the items back in stock").</p>
                    <form method="post" asp-page-handler="Void" asp-route-id="@Model.Id"
                          onsubmit="return confirm('Void sale #@Model.Id for @Model.Total.ToString("C")? This cannot be undone.');">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">Void this sale</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
