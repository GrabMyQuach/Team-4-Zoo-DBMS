@page "{id:int}"
@model ZooDatabase.Pages.Shop.ProductDetailsModel
@{
    ViewData["Title"] = Model.Name;
    var maxWeek = Model.Weeks.Count == 0 ? 1 : Math.Max(1, Model.Weeks.Max(w => w.Sold));
    bool low = Model.Stock != null && Model.Reorder != null && Model.Stock <= Model.Reorder;
}

<a href="/Shop/Products" class="back-link mt-0 mb-3 d-inline-block">← All products</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="border-bottom pb-3 mb-4 d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1 class="h2 mb-1">@Model.Name</h1>
        <div class="text-muted">
            @(Model.Category ?? "Product") · <a href="/Shop/GiftShopDetails/@Model.ShopId">@Model.Shop</a> · @Model.Price.ToString("C")
        </div>
        @if (Model.Description != null)
        {
            <div class="small text-muted mt-1">@Model.Description</div>
        }
    </div>
    @if (Model.CanManage)
    {
        <a href="/Shop/ProductEdit/@Model.Id" class="btn btn-primary rounded-pill px-4">Edit</a>
    }
</div>

@if (low)
{
    <div class="alert alert-warning">Stock is at or below the reorder level. <a href="/Shop/Inventory">Go to Inventory</a> to reorder.</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">In stock</div>
            <div class="stat-value @(low ? "text-danger" : "")">@(Model.Stock?.ToString() ?? "—")</div>
            <div class="small text-muted">Reorder at @(Model.Reorder?.ToString() ?? "—")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Sells per day</div>
            <div class="stat-value">@Model.DailySales</div>
            <div class="small text-muted">30-day average</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Days of stock left</div>
            <div class="stat-value @(Model.DaysLeft < 14 ? "text-warning" : "")">@(Model.DaysLeft?.ToString() ?? "—")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Margin</div>
            <div class="stat-value">@(Model.LowestCost == null || Model.Price == 0 ? "—" : Math.Round(100 * (Model.Price - Model.LowestCost.Value) / Model.Price, 1) + "%")</div>
            <div class="small text-muted">@(Model.LowestCost == null ? "No supplier cost" : "Best cost " + Model.LowestCost.Value.ToString("C"))</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Weekly Sales, Last 12 Weeks</h2></div>
            <table class="table table-sm align-middle mb-0">
                <tbody>
                    @foreach (var w in Model.Weeks)
                    {
                        <tr>
                            <td style="width: 90px;">@w.Week.ToString("MMM d")</td>
                            <td><div class="mini-bar"><div class="mini-bar-fill" style="width: @(w.Sold * 100 / maxWeek)%;"></div></div></td>
                            <td class="text-end small">@w.Sold sold</td>
                            <td class="text-end small">@w.Revenue.ToString("C0")</td>
                        </tr>
                    }
                    @if (Model.Weeks.Count == 0)
                    {
                        <tr><td class="text-center text-muted py-3">No sales in the last 12 weeks.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card mb-4">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Suppliers</h2></div>
            <table class="table align-middle mb-0">
                <tbody>
                    @foreach (var s in Model.Suppliers)
                    {
                        <tr>
                            <td><span class="fw-semibold">@s.Supplier</span><div class="small text-muted">@s.Delivery</div></td>
                            <td class="small">@s.Availability</td>
                            <td class="text-end">@(s.Cost?.ToString("C") ?? "—")</td>
                        </tr>
                    }
                    @if (Model.Suppliers.Count == 0)
                    {
                        <tr><td class="text-center text-muted py-3">No suppliers on file.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Restock Orders</h2></div>
            <table class="table align-middle mb-0">
                <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td>#@o.Id<div class="small text-muted">@o.Ordered.ToString("MMM d, yyyy")</div></td>
                            <td class="text-end">@o.Qty.ToString("0")</td>
                            <td><span class="badge @(o.Status == "Received" ? "bg-success" : o.Status == "Cancelled" ? "bg-secondary" : "bg-warning text-dark")">@o.Status</span></td>
                            <td class="text-end">@(o.Total?.ToString("C0") ?? "—")</td>
                        </tr>
                    }
                    @if (Model.Orders.Count == 0)
                    {
                        <tr><td class="text-center text-muted py-3">No restock orders yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
