@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
}

<div class="card mx-auto mt-4" style="max-width: 560px;">
    <div class="card-body p-5 text-center">
        <div class="error-code">@(Model.Code ?? 500)</div>
        <h1 class="h3 mt-2">@Model.Heading</h1>
        <p class="text-muted mt-3 mb-4">@Model.Message</p>
        <div class="d-flex gap-2 justify-content-center">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">Go Back</a>
            <a href="/" class="btn btn-primary rounded-pill px-4">Home</a>
        </div>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mt-4 mb-0">Reference: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
