@page
@model ZooDatabase.Pages.Tickets.TicketSaleNewModel
@using ZooDatabase.Data
@{
    ViewData["Title"] = "New Ticket Sale";
}

<a href="/Tickets/TicketSales" class="back-link mt-0 mb-3 d-inline-block">← Back</a>

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">New Ticket Sale</h1>
</div>

<div class="card" style="max-width: 820px;">
    <div class="card-body p-4">
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Customer *</label>
                    <select name="CustomerId" class="form-select">
                        <option value="0">Choose a customer…</option>
                        @foreach (var c in Model.Customers)
                        {
                            <option value="@c.Id" selected="@(Model.CustomerId == c.Id)">@c.Name</option>
                        }
                    </select>
                    <a href="/Tickets/CustomerEdit?next=sale" class="small">+ New customer</a>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Visit date *</label>
                    <input type="date" name="VisitDate" value="@Model.VisitDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
            </div>

            <table class="table align-middle mb-4">
                <thead class="table-light">
                    <tr><th>Ticket</th><th class="text-end">Price</th><th style="width: 120px;">Quantity</th><th class="text-end">Line Total</th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.TicketTypes)
                    {
                        var qty = Model.Quantities.TryGetValue(t.Id, out var q) ? q : 0;
                        <tr>
                            <td>
                                <span class="fw-semibold">@t.Name</span>
                                @if (t.Eligibility != null)
                                {
                                    <div class="small text-muted">@t.Eligibility</div>
                                }
                            </td>
                            <td class="text-end">@t.Price.ToString("C")</td>
                            <td>
                                <input type="number" name="Quantities[@t.Id]" value="@qty" min="0" max="50"
                                       class="form-control qty" data-price="@t.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            </td>
                            <td class="text-end line-total">$0.00</td>
                        </tr>
                    }
                    <tr class="table-light">
                        <td colspan="3" class="text-end fw-semibold">Total</td>
                        <td class="text-end fw-bold" id="grand-total">$0.00</td>
                    </tr>
                </tbody>
            </table>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Payment method *</label>
                    <select name="PaymentMethod" class="form-select">
                        @foreach (var p in SalesOptions.PaymentMethods)
                        {
                            <option value="@p" selected="@(Model.PaymentMethod == p)">@p</option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Complete Sale</button>
                <a href="/Tickets/TicketSales" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Live total so the cashier can read it to the customer (the database recalculates it on save)
        (function () {
            var money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
            function update() {
                var total = 0;
                document.querySelectorAll('.qty').forEach(function (input) {
                    var line = (parseInt(input.value) || 0) * parseFloat(input.dataset.price);
                    input.closest('tr').querySelector('.line-total').textContent = money.format(line);
                    total += line;
                });
                document.getElementById('grand-total').textContent = money.format(total);
            }
            document.querySelectorAll('.qty').forEach(function (i) { i.addEventListener('input', update); });
            update();
        })();
    </script>
}
