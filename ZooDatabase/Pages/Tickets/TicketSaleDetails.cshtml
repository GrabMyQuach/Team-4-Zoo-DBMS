@page "{id:int}"
@model ZooDatabase.Pages.Tickets.TicketSaleDetailsModel
@{
    ViewData["Title"] = "Ticket Order #" + Model.Id;
}

<a href="/Tickets/TicketSales" class="back-link mt-0 mb-3 d-inline-block">← All ticket sales</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-1">Ticket Order #@Model.Id</h1>
    <div class="text-muted">
        <a href="/Tickets/CustomerDetails/@Model.CustomerId">@Model.Customer</a>
        · visiting @Model.VisitDate.ToString("dddd, MMM d, yyyy")
        @if (Model.Membership != null)
        {
            <span class="badge bg-success ms-1">@Model.Membership member</span>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Tickets</h2></div>
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Ticket Type</th><th class="text-end">Qty</th><th class="text-end">Price Each</th><th class="text-end">Line Total</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td>@i.TicketType</td>
                            <td class="text-end">@i.Quantity</td>
                            <td class="text-end">
                                @i.UnitPrice.ToString("C")
                                @if (i.UnitPrice != i.ListPrice)
                                {
                                    <div class="small text-muted">list price @i.ListPrice.ToString("C")</div>
                                }
                            </td>
                            <td class="text-end">@i.LineTotal.ToString("C")</td>
                        </tr>
                    }
                    <tr class="table-light">
                        <td colspan="3" class="text-end fw-semibold">Total</td>
                        <td class="text-end fw-bold">@Model.Total.ToString("C")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h5 section-heading">Order Info</h2>
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-5">Purchased</dt>
                    <dd class="col-sm-7">@Model.PurchaseDate.ToString("MMM d, yyyy h:mm tt")</dd>
                    <dt class="col-sm-5">Visit date</dt>
                    <dd class="col-sm-7">@Model.VisitDate.ToString("MMM d, yyyy")</dd>
                    <dt class="col-sm-5">Payment</dt>
                    <dd class="col-sm-7">@(Model.Payment ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
