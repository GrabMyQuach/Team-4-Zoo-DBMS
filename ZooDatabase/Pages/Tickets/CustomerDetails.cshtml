@page "{id:int}"
@model ZooDatabase.Pages.Tickets.CustomerDetailsModel
@using ZooDatabase.Data
@{
    ViewData["Title"] = Model.Name;
}

<a href="/Tickets/Customers" class="back-link mt-0 mb-3 d-inline-block">← All customers</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="border-bottom pb-3 mb-4 d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1 class="h2 mb-1">
            @Model.Name
            @if (Model.Current != null)
            {
                <span class="badge fs-6 align-middle @SalesOptions.MembershipBadge(Model.Current.Status)">@Model.Current.Type member</span>
            }
        </h1>
        @if (Model.ShowContact)
        {
            <div class="text-muted">@(Model.Email ?? "No email") · @(Model.Phone ?? "No phone")</div>
        }
    </div>
    @if (Model.CanSell)
    {
        <div class="d-flex gap-2">
            <a href="/Tickets/TicketSaleNew?customerId=@Model.Id" class="btn btn-primary rounded-pill px-4">Sell Tickets</a>
            <a href="/Tickets/MembershipNew?customerId=@Model.Id" class="btn btn-outline-primary rounded-pill px-4">@(Model.Current == null ? "Add Membership" : "Renew Membership")</a>
            <a href="/Tickets/CustomerEdit/@Model.Id" class="btn btn-outline-secondary rounded-pill px-4">Edit</a>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Visits</div>
            <div class="stat-value">@Model.PastVisits</div>
            <div class="small text-muted">@(Model.Visits.Count - Model.PastVisits) upcoming</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Lifetime spend</div>
            <div class="stat-value">@((Model.TicketSpend + Model.FoodSpend + Model.GiftSpend).ToString("C0"))</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Tickets</div>
            <div class="stat-value">@Model.TicketSpend.ToString("C0")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Food and gifts</div>
            <div class="stat-value">@((Model.FoodSpend + Model.GiftSpend).ToString("C0"))</div>
            <div class="small text-muted">@Model.FoodSpend.ToString("C0") food · @Model.GiftSpend.ToString("C0") gifts</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Memberships</h2></div>
            <table class="table align-middle mb-0">
                <tbody>
                    @foreach (var m in Model.Memberships)
                    {
                        <tr>
                            <td><span class="fw-semibold">@m.Type</span><div class="small text-muted">@m.Price.ToString("C") / year</div></td>
                            <td class="small">@m.Start.ToString("MMM d, yyyy") to @m.End.ToString("MMM d, yyyy")</td>
                            <td class="text-end"><span class="badge @SalesOptions.MembershipBadge(m.Status)">@m.Status</span></td>
                        </tr>
                    }
                    @if (Model.Memberships.Count == 0)
                    {
                        <tr><td class="text-center text-muted py-3">Never been a member.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Visits</h2></div>
            <table class="table table-hover align-middle mb-0">
                <tbody>
                    @foreach (var v in Model.Visits.Take(15))
                    {
                        <tr class="clickable-row" onclick="location.href='/Tickets/TicketSaleDetails/@v.Id'">
                            <td>
                                @v.VisitDate.ToString("ddd, MMM d, yyyy")
                                @if (v.VisitDate > DateTime.Today)
                                {
                                    <span class="badge bg-light text-dark border ms-1">Upcoming</span>
                                }
                            </td>
                            <td class="text-end">@v.Tickets tickets</td>
                            <td class="text-end fw-semibold">@v.Total.ToString("C")</td>
                        </tr>
                    }
                    @if (Model.Visits.Count == 0)
                    {
                        <tr><td class="text-center text-muted py-3">No ticket purchases.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Food and Gift Shop Purchases</h2></div>
            <table class="table align-middle mb-0">
                <tbody>
                    @foreach (var s in Model.ShopPurchases.Take(15))
                    {
                        <tr>
                            <td>@s.Date.ToString("MMM d, yyyy h:mm tt")</td>
                            <td>@s.Place</td>
                            <td><span class="badge bg-light text-dark border">@(s.Type == "Food" ? "Food" : "Gift Shop")</span></td>
                            <td class="text-end fw-semibold">@s.Total.ToString("C")</td>
                        </tr>
                    }
                    @if (Model.ShopPurchases.Count == 0)
                    {
                        <tr><td class="text-center text-muted py-3">No food or gift shop purchases linked to this customer.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
