@page
@model ZooDatabase.Pages.Tickets.EncountersModel
@{
    ViewData["Title"] = "Animal Encounters";
    string q(string show) => $"/Tickets/Encounters?Show={show}" + (Model.Animal != null ? $"&Animal={Model.Animal}" : "");
}

<div class="border-bottom pb-3 mb-4 d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1 class="h2 mb-1">Animal Encounters</h1>
        <p class="text-muted mb-0">
            Public meet-the-animal sessions.
            @if (Model.AnimalName != null)
            {
                <span>Showing <strong>@Model.AnimalName</strong> only · <a href="/Tickets/Encounters?Show=@Model.Show">show all animals</a></span>
            }
        </p>
    </div>
    @if (Model.CanEdit)
    {
        <a href="/Tickets/EncounterNew@(Model.Animal != null ? $"?animal={Model.Animal}" : "")" class="btn btn-primary rounded-pill px-4">+ Book Encounter</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted small fw-semibold">Next 7 days</div>
        <div class="fs-3 fw-bold">@Model.Next7Days</div>
        <div class="text-muted small">encounters scheduled</div>
    </div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted small fw-semibold">Guest places</div>
        <div class="fs-3 fw-bold">@Model.SeatsNext7Days</div>
        <div class="text-muted small">in the next 7 days</div>
    </div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100 @(Model.NeedAttention > 0 ? "border-danger" : "")"><div class="card-body">
        <div class="text-muted small fw-semibold">Needs attention</div>
        <div class="fs-3 fw-bold @(Model.NeedAttention > 0 ? "text-danger" : "")">@Model.NeedAttention</div>
        <div class="text-muted small">booked, but the animal isn't cleared</div>
    </div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted small fw-semibold">Waiting to be closed</div>
        <div class="fs-3 fw-bold">@Model.ToClose</div>
        <div class="text-muted small">finished, guest count not entered</div>
    </div></div></div>
</div>

<ul class="nav nav-pills mb-3 flex-wrap gap-1">
    @foreach (var (key, label) in ZooDatabase.Pages.Tickets.EncountersModel.Views)
    {
        <li class="nav-item"><a class="nav-link @(Model.Show == key ? "active" : "")" href="@q(key)">@label</a></li>
    }
</ul>

<div class="card">
    @if (Model.Rows.Count == 0)
    {
        <div class="card-body"><p class="text-muted mb-0">Nothing to show here.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>When</th><th>Animal</th><th>Where</th><th>Handler</th><th class="text-end">Guests</th><th>Status</th>
                        @if (Model.CanEdit) { <th></th> }</tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Rows)
                    {
                        bool open = e.Status == "Scheduled";
                        var badge = e.Status switch { "Completed" => "bg-success", "Cancelled" => "bg-secondary", _ => "bg-primary" };
                        <tr class="@(open && e.Problem != null && !e.IsPast ? "table-danger" : "")">
                            <td class="text-nowrap">
                                <div class="fw-semibold">@e.Start.ToString("ddd, MMM d")</div>
                                <div class="small text-muted">@e.Start.ToString("h:mm tt") · @e.Minutes min</div>
                            </td>
                            <td>
                                <a href="/Animals/Details/@e.AnimalId" class="fw-semibold">@e.Animal</a>
                                <div class="small text-muted">@e.Species</div>
                                @if (open && e.Problem != null)
                                {
                                    <div class="small text-danger fw-semibold">Not cleared: @e.Problem</div>
                                }
                            </td>
                            <td>@(e.Attraction ?? "—")</td>
                            <td>@(e.Handler ?? "—")</td>
                            <td class="text-end text-nowrap">
                                @(e.Attended?.ToString() ?? "–") / @(e.MaxGuests?.ToString() ?? "–")
                            </td>
                            <td>
                                <span class="badge @badge">@e.Status</span>
                                @if (e.CancelReason != null) { <div class="small text-muted">@e.CancelReason</div> }
                            </td>
                            @if (Model.CanEdit)
                            {
                                <td class="text-end" style="min-width: 220px;">
                                    @if (open && e.Start <= DateTime.Now)
                                    {
                                        <form method="post" asp-page-handler="Complete" asp-route-Show="@Model.Show" asp-route-Animal="@Model.Animal"
                                              class="d-flex gap-1 justify-content-end mb-1">
                                            <input type="hidden" name="encounterId" value="@e.Id" />
                                            <label for="g-@e.Id" class="visually-hidden">Guests who came</label>
                                            <input id="g-@e.Id" name="guests" type="number" min="0" max="@(e.MaxGuests ?? 500)" class="form-control form-control-sm" style="width: 80px;" placeholder="guests" required />
                                            <button type="submit" class="btn btn-sm btn-success">Close</button>
                                        </form>
                                    }
                                    @if (open)
                                    {
                                        <form method="post" asp-page-handler="Cancel" asp-route-Show="@Model.Show" asp-route-Animal="@Model.Animal"
                                              class="d-flex gap-1 justify-content-end">
                                            <input type="hidden" name="encounterId" value="@e.Id" />
                                            <label for="r-@e.Id" class="visually-hidden">Reason for cancelling</label>
                                            <input id="r-@e.Id" name="reason" class="form-control form-control-sm" style="width: 130px;" maxlength="255"
                                                   placeholder="reason" value="@(e.Problem != null ? "Animal " + e.Problem : "")" required />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Rows.Count == 200)
        {
            <div class="card-body small text-muted">Showing the first 200.</div>
        }
    }
</div>
<p class="text-muted small mt-3">
    The database refuses a booking for an animal that's in quarantine, suspended, waiting to be moved, or no longer at the zoo (<code>trg_encounter_guard</code>).
    A contagious diagnosis or a critical inspection of the animal's enclosure cancels its upcoming encounters automatically.
    Anything still booked with an animal that isn't cleared shows under <strong>Needs attention</strong>.
</p>
