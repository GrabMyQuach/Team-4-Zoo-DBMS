@page "{id:int?}"
@model ZooDatabase.Pages.Tickets.AttractionEditModel
@using ZooDatabase.Data
@{
    string title = Model.IsNew ? "Add Attraction" : "Edit " + Model.Name;
    ViewData["Title"] = title;
    var statuses = string.IsNullOrEmpty(Model.Status) || SalesOptions.AttractionStatuses.Contains(Model.Status)
        ? SalesOptions.AttractionStatuses
        : SalesOptions.AttractionStatuses.Append(Model.Status).ToArray();
}

<a href="/Tickets/Attractions" class="back-link mt-0 mb-3 d-inline-block">← Back</a>

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">@title</h1>
</div>

<div class="card" style="max-width: 640px;">
    <div class="card-body p-4">
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }
        <form method="post">
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label class="form-label fw-semibold">Name *</label>
                    <input asp-for="Name" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Type</label>
                    <input asp-for="Type" class="form-control" maxlength="100" placeholder="e.g. Ride, Show, Encounter" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Location</label>
                    <input asp-for="Location" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Extra price</label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0 if included with admission" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Status</label>
                    <select asp-for="Status" class="form-select">
                        @foreach (var s in statuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">@(Model.IsNew ? "Add Attraction" : "Save Changes")</button>
                <a href="/Tickets/Attractions" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>
