
@page
@model ZooDatabase.Pages.Tickets.BuyTicketsModel

@{
    ViewData["Title"] = "Buy Tickets";
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2">Buy Zoo Tickets</h1>
    <p class="text-muted">
        Choose your tickets for your next zoo visit.
    </p>
</div>

@if (TempData["OrderConfirmation"] is string confirmation)
{
    <div class="card border-success mb-4" style="max-width: 820px;">
        <div class="card-body p-4">
            <div class="text-muted small fw-semibold">
                ORDER CONFIRMATION
            </div>

            <h4 class="mt-2">@confirmation</h4>

            <p class="text-success fw-semibold mb-1">
                ✓ Order created
            </p>

            <p class="text-success fw-semibold mb-0">
                Your payment has been successful.
            </p>
        </div>
    </div>
}

<div class="card" style="max-width: 820px;">
    <div class="card-body p-4">

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }
        else
        {
            <form method="post" asp-antiforgery="true">

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Visit Date
                    </label>

                    <input type="date"
                           name="VisitDate"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="form-control"
                           required />
                </div>

                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var ticket in Model.TicketTypes)
                        {
                            <tr>
                                <td>
                                    <strong>@ticket.Name</strong>

                                    @if (ticket.Eligibility != null)
                                    {
                                        <div class="small text-muted">
                                            @ticket.Eligibility
                                        </div>
                                    }
                                </td>

                                <td>@ticket.Price.ToString("C")</td>

                                <td>
                                    <input type="number"
                                           name="Quantities[@ticket.Id]"
                                           value="0"
                                           min="0"
                                           max="50"
                                           class="form-control ticket-qty"
                                           style="width: 100px;"
                                           data-price="@ticket.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                </td>

                                <td class="ticket-subtotal">$0.00</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <h4 class="text-end">
                    Total: <span id="total">$0.00</span>
                </h4>

                <div class="mb-4">
                    <label for="paymentMethod"
                           class="form-label fw-semibold">
                        Payment Method *
                    </label>

                    <select id="paymentMethod"
                            name="PaymentMethod"
                            class="form-select"
                            style="max-width: 450px;"
                            required>
                        <option value="">Select Payment Method</option>
                        <option value="Credit Card">Credit Card</option>
                        <option value="Debit Card">Debit Card</option>
                        <option value="Mobile Pay">Mobile Pay</option>
                        <option value="PayPal">PayPal</option>
                    </select>
                </div>

                <button type="submit"
                        class="btn btn-success rounded-pill px-4"
                        id="checkoutButton">
                    Continue to Checkout
                </button>

                <p class="small text-muted mt-2">
                    Select at least one ticket to continue.
                </p>

            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        function updateTotal() {
            let total = 0;
            let hasTickets = false;

            document.querySelectorAll(".ticket-qty")
                .forEach(input => {
                    const quantity = Number(input.value) || 0;
                    const price = Number(input.dataset.price);
                    const subtotal = quantity * price;

                    if (quantity > 0) {
                        hasTickets = true;
                    }

                    input.closest("tr")
                        .querySelector(".ticket-subtotal")
                        .textContent = subtotal.toLocaleString(
                            "en-US",
                            {
                                style: "currency",
                                currency: "USD"
                            }
                        );

                    total += subtotal;
                });

            document.getElementById("total").textContent =
                total.toLocaleString(
                    "en-US",
                    {
                        style: "currency",
                        currency: "USD"
                    }
                );

            document.getElementById("checkoutButton").disabled =
                !hasTickets;
        }

        document.querySelectorAll(".ticket-qty")
            .forEach(input => {
                input.addEventListener("input", updateTotal);
            });

        updateTotal();
    </script>
}

