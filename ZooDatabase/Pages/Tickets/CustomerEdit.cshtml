@page "{id:int?}"
@model ZooDatabase.Pages.Tickets.CustomerEditModel
@{
    string title = Model.IsNew ? "Add Customer" : $"Edit {Model.FirstName} {Model.LastName}";
    ViewData["Title"] = title;
    string cancelUrl = Model.IsNew ? (Model.Next == "sale" ? "/Tickets/TicketSaleNew" : "/Tickets/Customers") : $"/Tickets/CustomerDetails/{Model.Id}";
}

<a href="@cancelUrl" class="back-link mt-0 mb-3 d-inline-block">← Back</a>

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">@title</h1>
</div>

<div class="card" style="max-width: 640px;">
    <div class="card-body p-4">
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }
        <form method="post">
            <input type="hidden" name="Next" value="@Model.Next" />
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">First name *</label>
                    <input asp-for="FirstName" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Last name *</label>
                    <input asp-for="LastName" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-7">
                    <label class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Phone</label>
                    <input asp-for="Phone" class="form-control" maxlength="20" placeholder="713-555-0100" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">@(Model.IsNew ? (Model.Next == "sale" ? "Add and Sell Tickets" : "Add Customer") : "Save Changes")</button>
                <a href="@cancelUrl" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>
