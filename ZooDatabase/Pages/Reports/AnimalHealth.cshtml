@page
@model ZooDatabase.Pages.Reports.AnimalHealthModel
@using ZooDatabase.Pages.Reports
@{
    ViewData["Title"] = "Animal Health Report";
    ViewData["ReportTitle"] = "Animal Health & Veterinary";
    ViewData["ReportFilters"] = Model.FilterText;
    var maxMonth = Model.Months.Count == 0 ? 1 : Math.Max(1, Model.Months.Max(m => m.Total));
}

<partial name="_ReportHeader" model="Model" />

<!-- Filters -->
<div class="card mb-4 no-print">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">From</label>
                <input type="date" name="From" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">To</label>
                <input type="date" name="To" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Species</label>
                <select name="SpeciesId" class="form-select">
                    <option value="">All species</option>
                    @foreach (var o in Model.SpeciesOptions)
                    {
                        <option value="@o.Id" selected="@(Model.SpeciesId == o.Id)">@o.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Veterinarian</label>
                <select name="VetId" class="form-select">
                    <option value="">All vets</option>
                    @foreach (var o in Model.VetOptions)
                    {
                        <option value="@o.Id" selected="@(Model.VetId == o.Id)">@o.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Record type</label>
                <select name="RecordType" class="form-select">
                    <option value="">All types</option>
                    @foreach (var t in AnimalHealthModel.RecordTypes)
                    {
                        <option value="@t" selected="@(Model.RecordType == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Run</button>
                <a href="/Reports/AnimalHealth" class="btn btn-link px-1">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Headline numbers -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Vet records</div>
            <div class="stat-value">@Model.TotalRecords</div>
            <div class="small text-muted">@Model.AnimalsExamined animals examined</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Illness and injury cases</div>
            <div class="stat-value">@Model.IllnessInjuryCases</div>
            <div class="small text-muted">@Model.SeriousCases high or critical</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Contagious cases</div>
            <div class="stat-value @(Model.ContagiousCases > 0 ? "text-danger" : "")">@Model.ContagiousCases</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Quarantines started</div>
            <div class="stat-value">@Model.QuarantinesStarted</div>
            <div class="small text-muted">
                @(Model.AvgQuarantineDays == null ? "No quarantines" : $"Avg {Model.AvgQuarantineDays} days · {Model.StillQuarantined} still active")
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Overdue for checkup</div>
            <div class="stat-value @(Model.Overdue.Count > 0 ? "text-warning" : "")">@Model.Overdue.Count</div>
            <div class="small text-muted">No routine exam in 12 months</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <!-- Monthly trend -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 section-heading">Monthly Trend</h2>
                <table class="table table-sm align-middle mb-0 trend-table">
                    <thead class="table-light">
                        <tr><th>Month</th><th style="width: 20%;"></th><th class="text-end">Total</th><th class="text-end">Checkups</th><th class="text-end">Ill/Injured</th><th class="text-end">Contagious</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Months)
                        {
                            <tr>
                                <td>@ReportPageModel.MonthName(m.YearMonth)</td>
                                <td>
                                    <div class="mini-bar">
                                        <div class="mini-bar-fill" style="width: @(m.Total * 100 / maxMonth)%;"></div>
                                    </div>
                                </td>
                                <td class="text-end">@m.Total</td>
                                <td class="text-end">@m.Routine</td>
                                <td class="text-end">@m.Cases</td>
                                <td class="text-end @(m.Contagious > 0 ? "text-danger fw-semibold" : "")">@m.Contagious</td>
                            </tr>
                        }
                        @if (Model.Months.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">No records in this period.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Vet caseload -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 section-heading">Veterinarian Caseload</h2>
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Veterinarian</th><th class="text-end">Exams</th><th class="text-end">Ill/Injured</th><th class="text-end">Animals</th><th class="text-end">Open Tasks</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Vets)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@v.Name</span>
                                    <div class="small text-muted">@v.Specialization</div>
                                </td>
                                <td class="text-end">@v.Exams</td>
                                <td class="text-end">@v.Cases</td>
                                <td class="text-end">@v.AnimalsSeen</td>
                                <td class="text-end">@v.OpenTasks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- By species -->
    <div class="col-12">
        <div class="card">
            <div class="card-body pb-0">
                <h2 class="h5 section-heading">Health by Species</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Species</th><th class="text-end">Animals</th><th class="text-end">Records</th><th class="text-end">Ill/Injured</th><th class="text-end">Cases per Animal</th><th class="text-end">Contagious</th><th class="text-end">Serious</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.BySpecies)
                        {
                            <tr class="@(s.CasesPerAnimal >= 1 ? "table-warning" : "")">
                                <td class="fw-semibold">@s.Species</td>
                                <td class="text-end">@s.Animals</td>
                                <td class="text-end">@s.Records</td>
                                <td class="text-end">@s.Cases</td>
                                <td class="text-end">@s.CasesPerAnimal.ToString("0.##")</td>
                                <td class="text-end">@s.Contagious</td>
                                <td class="text-end">@s.Serious</td>
                            </tr>
                        }
                        @if (Model.BySpecies.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-3">No records in this period.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Weight changes -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body pb-0">
                <h2 class="h5 section-heading">Weight Change</h2>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Animal</th><th class="text-end">First</th><th class="text-end">Latest</th><th class="text-end">Change</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Model.Weights)
                        {
                            <tr class="@(w.ChangePercent <= -10 ? "table-danger" : w.ChangePercent <= -5 ? "table-warning" : "")">
                                <td>
                                    <span class="fw-semibold">@w.Animal</span>
                                    <div class="small text-muted">@w.Species</div>
                                </td>
                                <td class="text-end">@w.FirstWeight.ToString("0.#") kg<div class="small text-muted">@w.FirstDate.ToString("MMM d")</div></td>
                                <td class="text-end">@w.LatestWeight.ToString("0.#") kg<div class="small text-muted">@w.LatestDate.ToString("MMM d")</div></td>
                                <td class="text-end fw-semibold">@(w.ChangePercent > 0 ? "+" : "")@w.ChangePercent%</td>
                            </tr>
                        }
                        @if (Model.Weights.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">Not enough weigh-ins in this period.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Overdue checkups -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body pb-0">
                <h2 class="h5 section-heading">Overdue Checkups</h2>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Animal</th><th>Last Checkup</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Overdue)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@o.Animal</span>
                                    <div class="small text-muted">@o.Species · @o.Enclosure</div>
                                </td>
                                <td>
                                    @if (o.LastCheckup == null)
                                    {
                                        <span class="badge bg-danger">Never</span>
                                    }
                                    else
                                    {
                                        <span>@o.LastCheckup.Value.ToString("MMM d, yyyy")</span>
                                        <div class="small text-danger">@o.DaysSince days ago</div>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.Overdue.Count == 0)
                        {
                            <tr><td colspan="2" class="text-center text-muted py-3">All animals are up to date.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
