@page
@model ZooDatabase.Pages.Reports.FeedingModel
@using ZooDatabase.Data
@{
    ViewData["Title"] = "Feeding Report";
    ViewData["ReportTitle"] = "Feeding & Nutrition Compliance";
    ViewData["ReportFilters"] = Model.FilterText;
}

<partial name="_ReportHeader" model="Model" />

<!-- Filters -->
<div class="card mb-4 no-print">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">From</label>
                <input type="date" name="From" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">To</label>
                <input type="date" name="To" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Enclosure</label>
                <select name="EnclosureId" class="form-select">
                    <option value="">All enclosures</option>
                    @foreach (var o in Model.EnclosureOptions)
                    {
                        <option value="@o.Id" selected="@(Model.EnclosureId == o.Id)">@o.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Keeper</label>
                <select name="KeeperId" class="form-select">
                    <option value="">All keepers</option>
                    @foreach (var o in Model.KeeperOptions)
                    {
                        <option value="@o.Id" selected="@(Model.KeeperId == o.Id)">@o.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Run</button>
                <a href="/Reports/Feeding" class="btn btn-link px-1">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Headline numbers -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Completion rate</div>
            <div class="stat-value @(Model.Totals.CompletionRate < 95 ? "text-warning" : "")">@Model.Totals.CompletionRate%</div>
            <div class="small text-muted">@Model.Totals.Completed of @Model.Totals.Logged logged feedings</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Refused</div>
            <div class="stat-value">@Model.Totals.Refused</div>
            <div class="small text-muted">@Model.Totals.Partial partially eaten</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Missed by staff</div>
            <div class="stat-value @(Model.Totals.Missed > 0 ? "text-danger" : "")">@Model.Totals.Missed</div>
            <div class="small text-muted">@Model.NotLogged scheduled but not logged</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Appetite concerns</div>
            <div class="stat-value @(Model.Concerns.Count > 0 ? "text-danger" : "")">@Model.Concerns.Count</div>
            <div class="small text-muted">Animals, last 7 days</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Feed cost</div>
            <div class="stat-value">@Model.FeedCostInPeriod.ToString("C0")</div>
            <div class="small text-muted">@Model.DayCount days · @((Model.DayCount == 0 ? 0 : Model.FeedCostInPeriod / Model.DayCount).ToString("C0"))/day</div>
        </div></div>
    </div>
</div>

<!-- Appetite concerns -->
<div class="card mb-4">
    <div class="card-body pb-0">
        <h2 class="h5 section-heading">Appetite Concerns</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Animal</th><th>Enclosure</th><th>Health</th><th class="text-end">Refused</th><th class="text-end">Missed</th><th class="text-end">Partial</th><th>Last Problem</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Concerns)
                {
                    <tr class="table-danger">
                        <td><span class="fw-semibold">@c.Animal</span><div class="small text-muted">@c.Species</div></td>
                        <td>@c.Enclosure</td>
                        <td>
                            @if (c.HealthStatus != null)
                            {
                                <span class="badge @AnimalOptions.HealthBadgeClass(c.HealthStatus)">@c.HealthStatus</span>
                            }
                        </td>
                        <td class="text-end">@c.Refused</td>
                        <td class="text-end">@c.Missed</td>
                        <td class="text-end">@c.Partial</td>
                        <td>@(c.LastProblem?.ToString("MMM d") ?? "—")</td>
                    </tr>
                }
                @if (Model.Concerns.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-3">No appetite concerns in the last 7 days.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- By enclosure -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body pb-0">
                <h2 class="h5 section-heading">Compliance by Enclosure</h2>
            </div>
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Enclosure</th><th style="width: 30%;"></th><th class="text-end">Rate</th><th class="text-end">Refused</th><th class="text-end">Missed</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.ByEnclosure)
                    {
                        <tr class="@(g.Counts.CompletionRate < 95 ? "table-warning" : "")">
                            <td>@g.Name</td>
                            <td><div class="mini-bar"><div class="mini-bar-fill" style="width: @((int)g.Counts.CompletionRate)%;"></div></div></td>
                            <td class="text-end">@g.Counts.CompletionRate%</td>
                            <td class="text-end">@g.Counts.Refused</td>
                            <td class="text-end">@g.Counts.Missed</td>
                        </tr>
                    }
                    @if (Model.ByEnclosure.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">No feedings logged in this period.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- By keeper -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body pb-0">
                <h2 class="h5 section-heading">Compliance by Keeper</h2>
            </div>
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Keeper</th><th class="text-end">Logged</th><th class="text-end">Rate</th><th class="text-end">Refused</th><th class="text-end">Missed</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.ByKeeper)
                    {
                        <tr class="@(g.Counts.CompletionRate < 95 ? "table-warning" : "")">
                            <td>@g.Name</td>
                            <td class="text-end">@g.Counts.Logged</td>
                            <td class="text-end">@g.Counts.CompletionRate%</td>
                            <td class="text-end">@g.Counts.Refused</td>
                            <td class="text-end @(g.Counts.Missed > 0 ? "text-danger fw-semibold" : "")">@g.Counts.Missed</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Weekly trend -->
<div class="card mb-4">
    <div class="card-body pb-0">
        <h2 class="h5 section-heading">Weekly Trend</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr><th>Week of</th><th style="width: 40%;">Completion</th><th class="text-end">Rate</th><th class="text-end">Logged</th><th class="text-end">Refused</th><th class="text-end">Missed</th></tr>
            </thead>
            <tbody>
                @foreach (var w in Model.Weeks)
                {
                    <tr>
                        <td>@w.WeekStart.ToString("MMM d")</td>
                        <td><div class="mini-bar"><div class="mini-bar-fill" style="width: @((int)w.Counts.CompletionRate)%;"></div></div></td>
                        <td class="text-end">@w.Counts.CompletionRate%</td>
                        <td class="text-end">@w.Counts.Logged</td>
                        <td class="text-end">@w.Counts.Refused</td>
                        <td class="text-end">@w.Counts.Missed</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Feed supply -->
<div class="card">
    <div class="card-body pb-0">
        <h2 class="h5 section-heading">Feed Supply & Cost</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Feed</th><th class="text-end">In Stock</th><th class="text-end">Daily Use</th><th class="text-end">Days Left</th><th class="text-end">Cost / Day</th><th class="text-end">Cost in Period</th><th class="text-end">Open Orders</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Feeds)
                {
                    <tr class="@(f.StatusText == "OK" ? "" : "table-warning")">
                        <td><span class="fw-semibold">@f.Name</span><div class="small text-muted">@(f.Supplier ?? "No supplier")</div></td>
                        <td class="text-end">@f.InStock.ToString("0.#") @f.Unit</td>
                        <td class="text-end">@f.DailyUse.ToString("0.#") @f.Unit</td>
                        <td class="text-end">@(f.DaysOfSupply?.ToString("0.#") ?? "—")</td>
                        <td class="text-end">@(f.CostPerDay?.ToString("C") ?? "—")</td>
                        <td class="text-end">@(f.CostInPeriod?.ToString("C0") ?? "—")</td>
                        <td class="text-end">@f.OpenOrders</td>
                        <td class="small">@f.StatusText</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
