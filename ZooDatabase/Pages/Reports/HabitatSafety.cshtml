@page
@model ZooDatabase.Pages.Reports.HabitatSafetyModel
@using ZooDatabase.Pages.Reports
@{
    ViewData["Title"] = "Habitat Safety Report";
    ViewData["ReportTitle"] = "Habitat Safety & Maintenance";
    ViewData["ReportFilters"] = Model.FilterText;
    var maxCost = Model.Months.Count == 0 ? 1m : Math.Max(1m, Model.Months.Max(m => m.Cost));
}

<partial name="_ReportHeader" model="Model" />

<!-- Filters -->
<div class="card mb-4 no-print">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">From</label>
                <input type="date" name="From" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">To</label>
                <input type="date" name="To" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Enclosure</label>
                <select name="EnclosureId" class="form-select">
                    <option value="">All enclosures</option>
                    @foreach (var o in Model.EnclosureOptions)
                    {
                        <option value="@o.Id" selected="@(Model.EnclosureId == o.Id)">@o.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Issue category</label>
                <select name="Category" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var c in HabitatSafetyModel.IssueCategories)
                    {
                        <option value="@c" selected="@(Model.Category == c)">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Run</button>
                <a href="/Reports/HabitatSafety" class="btn btn-link px-1">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Headline numbers -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Inspection pass rate</div>
            <div class="stat-value @(Model.Inspections > 0 && Model.PassRate < 80 ? "text-warning" : "")">@Model.PassRate%</div>
            <div class="small text-muted">@Model.Passed of @Model.Inspections inspections</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Critical failures</div>
            <div class="stat-value @(Model.Critical > 0 ? "text-danger" : "")">@Model.Critical</div>
            <div class="small text-muted">@Model.Minor with minor issues</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Repairs completed</div>
            <div class="stat-value">@Model.RepairsCompleted</div>
            <div class="small text-muted">of @Model.RepairsRequested requested</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Average time to fix</div>
            <div class="stat-value">@(Model.AvgDaysToFix == null ? "—" : Model.AvgDaysToFix + " days")</div>
            <div class="small text-muted">@Model.RepairCost.ToString("C0") spent on repairs</div>
        </div></div>
    </div>
    <div class="col-6 col-lg">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Urgent work open</div>
            <div class="stat-value @(Model.OpenUrgent > 0 ? "text-danger" : "")">@Model.OpenUrgent</div>
            <div class="small text-muted">High or emergency, as of today</div>
        </div></div>
    </div>
</div>

<!-- Enclosure scorecard -->
<div class="card mb-4">
    <div class="card-body pb-0">
        <h2 class="h5 section-heading">Enclosure Scorecard</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Enclosure</th><th>Status</th><th class="text-end">Inspections</th><th class="text-end">Pass Rate</th><th class="text-end">Minor</th><th class="text-end">Critical</th><th>Last Inspected</th><th class="text-end">Open Repairs</th><th class="text-end">Repair Cost</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.ByEnclosure)
                {
                    var rowClass = e.Critical > 0 || e.Status != "Open" ? "table-danger"
                                 : e.DaysSince == null || e.DaysSince > 30 ? "table-warning" : "";
                    <tr class="@rowClass">
                        <td class="fw-semibold">@e.Name</td>
                        <td><span class="badge @(e.Status == "Open" ? "bg-success" : e.Status == "Closed" ? "bg-danger" : "bg-warning text-dark")">@e.Status</span></td>
                        <td class="text-end">@e.Inspections</td>
                        <td class="text-end">@(e.Inspections == 0 ? "—" : e.PassRate + "%")</td>
                        <td class="text-end">@e.Minor</td>
                        <td class="text-end">@e.Critical</td>
                        <td>
                            @if (e.LastInspected == null)
                            {
                                <span class="text-danger">Never</span>
                            }
                            else
                            {
                                <span>@e.LastInspected.Value.ToString("MMM d")</span>
                                <div class="small text-muted">@e.DaysSince days ago</div>
                            }
                        </td>
                        <td class="text-end">@e.OpenRepairs</td>
                        <td class="text-end">@e.RepairCost.ToString("C0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Issues by category -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body pb-0">
                <h2 class="h5 section-heading">Recurring Issues</h2>
            </div>
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Category</th><th class="text-end">Findings</th><th class="text-end">Critical</th><th class="text-end">Enclosures</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.ByCategory)
                    {
                        <tr>
                            <td>@c.Category<div class="small text-muted">Last seen @c.LastSeen.ToString("MMM d")</div></td>
                            <td class="text-end">@c.Findings</td>
                            <td class="text-end @(c.Critical > 0 ? "text-danger fw-semibold" : "")">@c.Critical</td>
                            <td class="text-end">@c.Enclosures</td>
                        </tr>
                    }
                    @if (Model.ByCategory.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">No issues found in this period.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Monthly -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body pb-0">
                <h2 class="h5 section-heading">Monthly Trend</h2>
            </div>
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Month</th><th class="text-end">Inspections</th><th class="text-end">Failed</th><th class="text-end">Repairs</th><th style="width: 25%;">Cost</th><th class="text-end"></th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Months)
                    {
                        <tr>
                            <td>@ReportPageModel.MonthName(m.YearMonth)</td>
                            <td class="text-end">@m.Inspections</td>
                            <td class="text-end @(m.Critical > 0 ? "text-danger fw-semibold" : "")">@(m.Minor + m.Critical)</td>
                            <td class="text-end">@m.Completed / @m.Requested</td>
                            <td><div class="mini-bar"><div class="mini-bar-fill" style="width: @((int)(m.Cost * 100 / maxCost))%;"></div></div></td>
                            <td class="text-end">@m.Cost.ToString("C0")</td>
                        </tr>
                    }
                    @if (Model.Months.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">No inspections or repairs in this period.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Follow-up on failed inspections -->
<div class="card mb-4">
    <div class="card-body pb-0">
        <h2 class="h5 section-heading">Failed Inspection Follow-up</h2>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Inspected</th><th>Enclosure</th><th>Result</th><th>Finding</th><th>Work Order</th><th>Repair Status</th><th class="text-end">Days</th></tr>
            </thead>
            <tbody>
                @foreach (var f in Model.FollowUps)
                {
                    <tr class="@(f.Late ? (f.Result == "Critical" ? "table-danger" : "table-warning") : "")">
                        <td>@f.Date.ToString("MMM d")<div class="small text-muted">@f.Inspector</div></td>
                        <td>@f.Enclosure</td>
                        <td><span class="badge @(f.Result == "Critical" ? "bg-danger" : "bg-warning text-dark")">@f.Result</span></td>
                        <td><span class="fw-semibold">@f.Category</span><div class="small text-muted">@f.Findings</div></td>
                        <td>@(f.MaintenanceId == null ? "—" : "#" + f.MaintenanceId)<div class="small text-muted">@f.Priority</div></td>
                        <td>@f.RepairStatus</td>
                        <td class="text-end">@(f.Days?.ToString() ?? "—")</td>
                    </tr>
                }
                @if (Model.FollowUps.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-3">No failed inspections in this period.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Open work orders -->
<div class="card">
    <div class="card-body pb-0">
        <h2 class="h5 section-heading">Open Work Orders</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Enclosure</th><th>Description</th><th>Priority</th><th>Status</th><th class="text-end">Days Open</th><th>Assigned To</th></tr>
            </thead>
            <tbody>
                @foreach (var w in Model.OpenWork)
                {
                    <tr class="@(w.Priority is "Emergency" or "High" ? "table-danger" : "")">
                        <td>@w.Id</td>
                        <td>@w.Enclosure</td>
                        <td>@w.Description</td>
                        <td>@w.Priority</td>
                        <td>@w.Status</td>
                        <td class="text-end">@(w.DaysOpen?.ToString() ?? "—")</td>
                        <td>@(w.AssignedTo ?? "Unassigned")</td>
                    </tr>
                }
                @if (Model.OpenWork.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-3">No open work orders.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
