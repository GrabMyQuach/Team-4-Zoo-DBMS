
@using ZooDatabase.Data

@{
    Layout = "_Layout";
    ViewData["InModule"] = true;

    var parts = Context.Request.Path.Value?.Trim('/').Split('/')
                ?? Array.Empty<string>();

    var module = ZooModules.Find(parts.ElementAtOrDefault(0));
    var currentSection = parts.ElementAtOrDefault(1);

    // Pages that aren't in the sidebar
    // highlight their related section.
    if (module != null && !module.Sections.Any(s =>
        string.Equals(s.Slug, currentSection,
            StringComparison.OrdinalIgnoreCase)))
    {
        var match = module.Sections.FirstOrDefault(s =>
            currentSection != null &&
            currentSection.StartsWith(
                s.Slug.TrimEnd('s'),
                StringComparison.OrdinalIgnoreCase));

        currentSection = match?.Slug ?? module.Sections[0].Slug;
    }

    bool canManageData =
        User.IsInRole("DBA") ||
        User.IsInRole("SuperUser") ||
        User.IsInRole("Admin");

    bool isCustomer = User.IsInRole("Customer");
}

<div class="row g-4">
    <aside class="col-md-3 col-lg-2">
        <div class="module-sidebar">

            <div class="module-title">@module?.Title</div>

            <nav class="nav flex-column">

                @if (module != null)
                {
                    foreach (var s in module.Sections)
                    {
                        // Hide sensitive sections from customers.
                        if (isCustomer)
                        {
                            // Hide animal feed management.
                            if (module.Key == "Animals" &&
                                s.Slug == "Feed")
                            {
                                continue;
                            }

                            // Hide shop management.
                            if (module.Key == "Shop" &&
                                (s.Slug == "Inventory" ||
                                 s.Slug == "Suppliers" ||
                                 s.Slug == "Sales"))
                            {
                                continue;
                            }

                            // Hide internal ticket management.
                            if (module.Key == "Tickets" &&
                                (s.Slug == "TicketSales" ||
                                 s.Slug == "Customers" ||
                                 s.Slug == "Memberships"))
                            {
                                continue;
                            }
                        }

                        // Cashiers can only see approved sections.
                        if (User.IsInRole("Cashier") &&
                            s.Slug != "TicketSales" &&
                            s.Slug != "TicketTypes" &&
                            s.Slug != "Memberships")
                        {
                            continue;
                        }

                        // Hide staff management from unauthorized users.
                        if (module.Key == "Staff" &&
                            s.Slug == "EmployeeManage" &&
                            !canManageData)
                        {
                            continue;
                        }

                        // Reports follow centralized role permissions.
                        if (s.Slug == "Reports" &&
                            !ReportAccess.CanView(User))
                        {
                            continue;
                        }

                        var isActive = string.Equals(
                            s.Slug,
                            currentSection,
                            StringComparison.OrdinalIgnoreCase);

                        <a class="nav-link @(isActive ? "active" : "")"
                           href="/@module.Key/@s.Slug">
                            @s.Title
                        </a>
                    }
                }

            </nav>
            <a href="/Dashboard" class="back-link">← Main Menu</a>
        </div>
    </aside>

    <section class="col-md-9 col-lg-10">
        @RenderBody()
    </section>
</div>

@await RenderSectionAsync("Scripts", required: false)
