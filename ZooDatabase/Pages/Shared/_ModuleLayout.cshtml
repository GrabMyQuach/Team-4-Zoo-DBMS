@using ZooDatabase.Data
@{
    Layout = "_Layout";

    var parts = Context.Request.Path.Value?.Trim('/').Split('/') ?? Array.Empty<string>();
    var module = ZooModules.Find(parts.ElementAtOrDefault(0));
    var currentSection = parts.ElementAtOrDefault(1) ?? module?.Sections[0].Slug;
    bool canSeeReports = User.IsInRole("SuperUser") || User.IsInRole("DBA");
    bool canManageData = User.IsInRole("DBA") ||
                     User.IsInRole("SuperUser") ||
                     User.IsInRole("Admin");
}

<div class="row g-4">
    <aside class="col-md-3 col-lg-2">
        <div class="module-sidebar">
            <div class="module-title">@module?.Title</div>
            <nav class="nav flex-column">
                @if (module != null)
                {
                    foreach (var s in module.Sections)
                    {
                        if (s.Title == "Reports" && !canSeeReports) { continue; }
                        if (module.Key == "Animals" && s.Slug == "Manage" && !canManageData) { continue; }
                        if (module.Key == "Staff" && s.Slug == "EmployeeManage" && !canManageData){ continue; }


                        if (User.IsInRole("Cashier"))
                        {
                            if (module.Key != "Tickets" ||
                               (s.Slug != "TicketSales" &&
                                s.Slug != "TicketTypes" &&
                                s.Slug != "Memberships"))
                           {
                                continue;
                           }
                        }

                        
                        if (User.IsInRole("ReadOnly"))
                        {
                        // Hide internal animal operations
                            if (module.Key == "Animals" &&
                               (s.Slug == "Manage" ||
                                s.Slug == "Enclosures" ||
                                s.Slug == "Feed"))
                            {
                                continue;
                            }

                        // Hide ticket sales and customer information
                            if (module.Key == "Tickets" &&
                               (s.Slug == "TicketSales" ||
                                s.Slug == "Customers"))
                            {
                                continue;
                            }

                       // Hide internal shop operations
                           if (module.Key == "Shop" &&
                              (s.Slug == "Inventory" ||
                               s.Slug == "Suppliers" ||
                               s.Slug == "Sales"))
                            {
                               continue;
                            }
                        }



                        var isActive = string.Equals(s.Slug, currentSection, StringComparison.OrdinalIgnoreCase);
                        <a class="nav-link @(isActive ? "active" : "")" href="/@module.Key/@s.Slug">@s.Title</a>
                    }
                }
            </nav>
            <a href="/" class="back-link">← Main Menu</a>
        </div>
    </aside>

    <section class="col-md-9 col-lg-10">
        @RenderBody()
    </section>
</div>