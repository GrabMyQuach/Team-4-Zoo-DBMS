@using ZooDatabase.Data
@{
    Layout = "_Layout";
    ViewData["InModule"] = true;

    var parts = Context.Request.Path.Value?.Trim('/').Split('/') ?? Array.Empty<string>();
    var module = ZooModules.Find(parts.ElementAtOrDefault(0));
    var currentSection = parts.ElementAtOrDefault(1);

    // Pages that aren't in the sidebar (like /Animals/Details/5 or /Animals/Edit)
    // highlight the section's first item, so you always know where you are.
       if (module != null && !module.Sections.Any(s =>
            string.Equals(s.Slug, currentSection, StringComparison.OrdinalIgnoreCase)))
    {
        // "EnclosureDetails" / "EnclosureEdit" belong to "Enclosures", etc.
        var match = module.Sections.FirstOrDefault(s => currentSection != null &&
            currentSection.StartsWith(s.Slug.TrimEnd('s'), StringComparison.OrdinalIgnoreCase));
        currentSection = match?.Slug ?? module.Sections[0].Slug;
    }

    
    bool canManageData = User.IsInRole("DBA") ||
                     User.IsInRole("SuperUser") ||
                     User.IsInRole("Admin");
}

<div class="row g-4">
    <aside class="col-md-3 col-lg-2">
        <div class="module-sidebar">
            <div class="module-title">@module?.Title</div>
            <nav class="nav flex-column">
                @if (module != null)
                {
                    foreach (var s in module.Sections)
                    {
                        // ReadOnly users cannot see sensitive sections.
                        if (User.IsInRole("ReadOnly"))
                        {
                            // Hide Feed from ReadOnly users.
                           if (User.IsInRole("ReadOnly") &&
                               module.Key == "Animals" &&
                               s.Slug == "Feed")
                            {
                               continue;
                            }
                            if (module.Key == "Shop" &&
                               (s.Slug == "Inventory" ||
                                s.Slug == "Suppliers" ||
                                s.Slug == "Sales"))
                            {
                                continue;
                            }

                            if (module.Key == "Tickets" &&
                               (s.Slug == "TicketSales" ||
                                s.Slug == "Customers" ||
                                s.Slug == "Memberships"))
                            {
                                continue;
                            }
                        }
                        // Show only permitted sections to Cashiers.
                        if (User.IsInRole("Cashier") &&
                           s.Slug != "TicketSales" &&
                           s.Slug != "TicketTypes" &&
                           s.Slug != "Memberships")
                       {
                           continue;
                       }

                       // Hide management sections from unauthorized users.
                       if (module.Key == "Staff" &&
                          s.Slug == "EmployeeManage" &&
                          !canManageData)
                       {
                          continue;
                       }

                      // Reports access follows the centralized role configuration.
                       if (s.Slug == "Reports" &&
                          !ReportAccess.CanView(User))
                       {
                          continue;
                       }

                        var isActive = string.Equals(s.Slug, currentSection, StringComparison.OrdinalIgnoreCase);
                        <a class="nav-link @(isActive ? "active" : "")" href="/@module.Key/@s.Slug">@s.Title</a>
                    }
                }
            </nav>
            <a href="/" class="back-link">← Main Menu</a>
        </div>
    </aside>

    <section class="col-md-9 col-lg-10">
        @RenderBody()
    </section>
</div>
@section Scripts {
    @RenderSection("Scripts", required: false)
}