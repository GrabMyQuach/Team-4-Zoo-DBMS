@using ZooDatabase.Data
@{
    // Section pages (Animals, Staff, ...) have their own sidebar from _ModuleLayout,
    // so the main menu only shows on the other pages (home, reports, admin, account).
    bool inModule = ViewData["InModule"] as bool? == true;
    bool showMainMenu = User.Identity?.IsAuthenticated == true && !inModule;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @PublicSite.ZooName Staff</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ZooDatabase.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/staff-theme.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar staff-bar mb-4">
            <div class="container">
                <a class="navbar-brand staff-brand" href="@(User.Identity?.IsAuthenticated == true ? "/Dashboard" : "/")">
                    @PublicSite.ZooName <span class="staff-tag">Staff</span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <a href="/" class="staff-link">View public site</a>
                        <a asp-page="/MyAccount" class="staff-user">
                            @User.Identity.Name
                            <span class="staff-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </a>
                        <form method="post" asp-page="/Logout" class="d-inline">
                            <button type="submit" class="btn btn-sm staff-logout">Log out</button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (showMainMenu)
            {
                <div class="row g-4">
                    <aside class="col-md-3 col-lg-2 no-print">
                        <partial name="_MainMenu" />
                    </aside>
                    <section class="col-md-9 col-lg-10">
                        @RenderBody()
                    </section>
                </div>
            }
            else
            {
                @RenderBody()
            }
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 @PublicSite.ZooName · Team 4 Zoo Management System · <a asp-area="" asp-page="/Privacy">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
