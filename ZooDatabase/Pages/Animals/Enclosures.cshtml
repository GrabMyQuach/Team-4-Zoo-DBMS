@page
@model ZooDatabase.Pages.Animals.EnclosuresModel
@{
    ViewData["Title"] = "Enclosures";
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">Enclosures</h1>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Enclosure</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th style="width: 220px;">Occupancy</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Rows)
                {
                    var percent = e.Capacity > 0 ? Math.Min(100, e.AnimalCount * 100 / e.Capacity) : 0;
                    var full = e.AnimalCount >= e.Capacity;
                    <tr>
                        <td class="fw-semibold">@e.Name</td>
                        <td>@e.Type</td>
                        <td>@e.Location</td>
                        <td>
                            <div class="small mb-1">
                                @e.AnimalCount / @e.Capacity
                                @if (full)
                                {
                                    <span class="badge bg-danger ms-1">Full</span>
                                }
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @(full ? "bg-danger" : "bg-success")"
                                     style="width: @percent%;"></div>
                            </div>
                        </td>
                    </tr>
                }

                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No enclosures found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>