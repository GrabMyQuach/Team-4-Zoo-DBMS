@page "{id:int?}"
@model ZooDatabase.Pages.Animals.EditModel
@using ZooDatabase.Data
@{
    ViewData["Title"] = Model.IsNew ? "Add Animal" : "Edit " + Model.Input.Name;
    string cancelUrl = Model.IsNew ? "/Animals/Animals" : $"/Animals/Details/{Model.Id}";

    // If an old record has a value that isn't in our list, keep it as a choice so it isn't lost
    string[] WithCurrent(string[] options, string? current) =>
        string.IsNullOrEmpty(current) || options.Contains(current) ? options : options.Append(current).ToArray();
}

<a href="@cancelUrl" class="back-link mt-0 mb-3 d-inline-block">← Back</a>

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">@(Model.IsNew ? "Add Animal" : "Edit " + Model.Input.Name)</h1>
</div>

<div class="card" style="max-width: 760px;">
    <div class="card-body p-4">

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Name *</label>
                    <input asp-for="Input.Name" class="form-control" placeholder="e.g. Simba" maxlength="100" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Species *</label>
                    <select asp-for="Input.SpeciesId" class="form-select">
                        <option value="0">Choose a species…</option>
                        @foreach (var s in Model.SpeciesOptions)
                        {
                            <option value="@s.Id">@s.Label</option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Enclosure *</label>
                    <select asp-for="Input.EnclosureId" class="form-select">
                        <option value="0">Choose an enclosure…</option>
                        @foreach (var e in Model.EnclosureOptions)
                        {
                            <option value="@e.Id">@e.Label</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Sex</label>
                    <select asp-for="Input.Gender" class="form-select">
                        <option value="">Not recorded</option>
                        @foreach (var g in WithCurrent(AnimalOptions.Genders, Model.Input.Gender))
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Health status</label>
                    <select asp-for="Input.HealthStatus" class="form-select">
                        @foreach (var h in WithCurrent(AnimalOptions.HealthStatuses, Model.Input.HealthStatus))
                        {
                            <option value="@h">@h</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Date of birth</label>
                    <input asp-for="Input.DateOfBirth" type="date" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Arrived at zoo</label>
                    <input asp-for="Input.DateAcquired" type="date" class="form-control" />
                </div>

                @if (Model.IsNew && Model.BreedingOptions.Count > 0)
                {
                    <div class="col-12">
                        <label class="form-label fw-semibold">Born here from a breeding event?</label>
                        <select asp-for="Input.BreedingId" class="form-select">
                            <option value="0">No</option>
                            @foreach (var b in Model.BreedingOptions)
                            {
                                <option value="@b.Id">@b.Label</option>
                            }
                        </select>
                        <div class="form-text">
                            Choosing one fills in the parents, enrolls the newborn in its conservation program,
                            and creates a neonatal vet exam and studbook task.
                        </div>
                    </div>
                }

                <div class="col-md-6">
                    <label class="form-label fw-semibold">How acquired</label>
                    <select asp-for="Input.AcquisitionType" class="form-select">
                        <option value="">Not recorded</option>
                        @foreach (var t in WithCurrent(AnimalOptions.AcquisitionTypes, Model.Input.AcquisitionType))
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    @(Model.IsNew ? "Add Animal" : "Save Changes")
                </button>
                <a href="@cancelUrl" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>
