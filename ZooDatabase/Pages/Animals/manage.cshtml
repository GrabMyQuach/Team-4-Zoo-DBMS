
@page
@model ZooDatabase.Pages.Animals.ManageModel

@{
    ViewData["Title"] = "Animal Management";
}

<div class="container mt-4">

    <h1>Animal Management</h1>
    <h3>Add New Animal</h3>

    <form method="post">

        <div class="mb-3">
            <label class="form-label">Animal Name</label>
            <input type="text" name="AnimalName"
                   class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Species ID</label>
            <input type="number" name="SpeciesId"
                   class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Gender</label>
            <select name="Gender" class="form-select">
                <option value="">Select Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Unknown">Unknown</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Date of Birth</label>
            <input type="date" name="DateOfBirth"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Health Status</label>
            <input type="text" name="HealthStatus"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Enclosure ID</label>
            <input type="number" name="EnclosureId"
                   class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Date Acquired</label>
            <input type="date" name="DateAcquired"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Acquisition Type</label>
            <input type="text" name="AcquisitionType"
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">
            Add Animal
        </button>

    </form>
    
<hr class="my-4" />

<h3>Existing Animals</h3>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Animal ID</th>
                <th>Name</th>
                <th>Species ID</th>
                <th>Enclosure ID</th>
                <th>Gender</th>
                <th>Health Status</th>
                <th>Date of Birth</th>
                <th>Date Acquired</th>
                <th>Acquisition Type</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var animal in Model.Animals)
            {
                <tr>
                    <td>@animal.AnimalId</td>
                    <td>@animal.AnimalName</td>
                    <td>@animal.SpeciesId</td>
                    <td>@animal.EnclosureId</td>
                    <td>@animal.Gender</td>
                    <td>@animal.HealthStatus</td>
                    <td>@animal.DateOfBirth?.ToString("yyyy-MM-dd")</td>
                    <td>@animal.DateAcquired?.ToString("yyyy-MM-dd")</td>
                    <td>@animal.AcquisitionType</td>
                    
                    <td>
                     <div class="d-flex gap-2">
                        <a asp-page="./Edit"
                           asp-route-id="@animal.AnimalId"
                           class="btn btn-primary btn-sm">
                           Edit
                        </a>

                        <form method="post"
                              asp-page-handler="Delete"
                              onsubmit="return confirm('Are you sure you want to delete this animal?');">

                           <input type="hidden"
                               name="AnimalId"
                               value="@animal.AnimalId" />

                           <button type="submit"
                                class="btn btn-danger btn-sm">
                              Delete
                           </button>
                        </form>
                     </div>
                   

                    </td>

                </tr>
            }

            @if (Model.Animals.Count == 0)
            {
                <tr>
                    <td colspan="10" class="text-center">
                        No animals found in the database.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

</div>



