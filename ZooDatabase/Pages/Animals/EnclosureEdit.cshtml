@page "{id:int?}"
@model ZooDatabase.Pages.Animals.EnclosureEditModel
@using ZooDatabase.Pages.Animals
@{
    ViewData["Title"] = Model.IsNew ? "Add Enclosure" : "Edit " + Model.Input.Name;
    string cancelUrl = Model.IsNew ? "/Animals/Enclosures" : $"/Animals/EnclosureDetails/{Model.Id}";
}

<a href="@cancelUrl" class="back-link mt-0 mb-3 d-inline-block">← Back</a>

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">@(Model.IsNew ? "Add Enclosure" : "Edit " + Model.Input.Name)</h1>
</div>

<div class="card" style="max-width: 760px;">
    <div class="card-body p-4">

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Name *</label>
                    <input asp-for="Input.Name" class="form-control" placeholder="e.g. Lion Savanna" maxlength="100" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Type</label>
                    <input asp-for="Input.Type" class="form-control" list="enclosure-types" placeholder="e.g. Savanna" maxlength="100" />
                    <datalist id="enclosure-types">
                        @foreach (var t in Model.ExistingTypes)
                        {
                            <option value="@t"></option>
                        }
                    </datalist>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Location</label>
                    <input asp-for="Input.Location" class="form-control" placeholder="e.g. African Zone" maxlength="100" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Capacity *</label>
                    <input asp-for="Input.Capacity" type="number" min="1" class="form-control" />
                    <div class="form-text">Maximum number of animals that can live here safely.</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Status</label>
                    <select asp-for="Input.Status" class="form-select">
                        @foreach (var s in EnclosuresModel.Statuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Reason (if not open)</label>
                    <input asp-for="Input.ClosedReason" class="form-control" placeholder="e.g. Fence repair" maxlength="255" />
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    @(Model.IsNew ? "Add Enclosure" : "Save Changes")
                </button>
                <a href="@cancelUrl" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>
