@page
@model ManageUsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">Manage Users</h1>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">All Users</h2>
    <a asp-page="/AddUser" class="btn btn-primary rounded-pill px-4">+ Add User</a>
</div>

<div class="card">
    <div class="card-body border-bottom">
        <form method="get" class="d-flex gap-2" style="max-width: 480px;">
            <input type="text" name="Search" value="@Model.Search" class="form-control"
                   placeholder="Search username or role" />
            <button type="submit" class="btn btn-outline-secondary rounded-pill px-4">Search</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Last Login</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>@u.UserId</td>
                        <td>@u.Username</td>
                        <td><span class="badge bg-success">@u.Role</span></td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-light text-success border">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border">Inactive</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td>@(u.LastLogin?.ToString("MMM d, yyyy h:mm tt") ?? "Never")</td>
                    </tr>
                }

                @if (Model.Users.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>