@page
@model ZooDatabase.Pages.Care.IndexModel
@{
    ViewData["Title"] = "Animal Care";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
}

<partial name="_CareNav" model="@("home")" />

<h1 class="mb-1">@greeting</h1>
<p class="text-muted mb-4">@DateTime.Today.ToString("dddd, MMMM d, yyyy") · What would you like to do?</p>

@if (Model.Keeper)
{
    @if (Model.Vet) { <h2 class="h4 section-heading mb-3">Keeper</h2> }
    <div class="register-cards mb-5">
        <a href="/Care/Feedings" class="register-card">
            <svg viewBox="0 0 64 64" width="88" height="88" aria-hidden="true">
                <path d="M10 30h44a22 18 0 0 1-44 0z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
                <path d="M24 22c0-6 4-6 4-12M34 22c0-6 4-6 4-12" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
                <path d="M22 54h20" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
            </svg>
            <span class="register-card-title">Today's Feedings</span>
            <span class="register-card-text">@(Model.FeedingsLeft == 0 ? $"All {Model.FeedingsToday} logged" : $"{Model.FeedingsLeft} of {Model.FeedingsToday} left to log")</span>
        </a>
        <a href="/Care/Tasks" class="register-card">
            <svg viewBox="0 0 64 64" width="88" height="88" aria-hidden="true">
                <rect x="12" y="8" width="40" height="50" rx="5" fill="none" stroke="currentColor" stroke-width="4" />
                <path d="M20 24l4 4 7-8M20 40l4 4 7-8M36 24h8M36 40h8" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="register-card-title">My Tasks</span>
            <span class="register-card-text">@Model.MyTasks open</span>
        </a>
        <a href="/Care/Animals" class="register-card">
            <svg viewBox="0 0 64 64" width="88" height="88" aria-hidden="true">
                <ellipse cx="32" cy="42" rx="12" ry="10" fill="none" stroke="currentColor" stroke-width="4" />
                <ellipse cx="14" cy="28" rx="5" ry="7" fill="none" stroke="currentColor" stroke-width="4" />
                <ellipse cx="25" cy="16" rx="5" ry="7" fill="none" stroke="currentColor" stroke-width="4" />
                <ellipse cx="39" cy="16" rx="5" ry="7" fill="none" stroke="currentColor" stroke-width="4" />
                <ellipse cx="50" cy="28" rx="5" ry="7" fill="none" stroke="currentColor" stroke-width="4" />
            </svg>
            <span class="register-card-title">My Animals</span>
            <span class="register-card-text">@Model.MyAnimals in your care</span>
        </a>
        <a href="/Care/Problem" class="register-card">
            <svg viewBox="0 0 64 64" width="88" height="88" aria-hidden="true">
                <path d="M32 8L58 54H6z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
                <path d="M32 26v12" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
                <circle cx="32" cy="46" r="2.5" fill="currentColor" />
            </svg>
            <span class="register-card-title">Report a Problem</span>
            <span class="register-card-text">Broken fence, water issue, anything unsafe</span>
        </a>
    </div>
}

@if (Model.Vet)
{
    @if (Model.Keeper) { <h2 class="h4 section-heading mb-3">Veterinary</h2> }
    <div class="register-cards">
        <a href="/Care/Attention" class="register-card">
            <svg viewBox="0 0 64 64" width="88" height="88" aria-hidden="true">
                <path d="M32 54S8 40 8 24a12 12 0 0 1 24-4 12 12 0 0 1 24 4c0 16-24 30-24 30z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
                <path d="M16 30h8l4-8 6 14 4-6h10" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="register-card-title">Needs Attention</span>
            <span class="register-card-text">@Model.NeedAttention @(Model.NeedAttention == 1 ? "animal" : "animals") to check</span>
        </a>
        <a href="/Care/Exam" class="register-card">
            <svg viewBox="0 0 64 64" width="88" height="88" aria-hidden="true">
                <path d="M18 8v18a12 12 0 0 0 24 0V8" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
                <path d="M30 38v6a10 10 0 0 0 20 0v-6" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
                <circle cx="50" cy="32" r="5" fill="none" stroke="currentColor" stroke-width="4" />
            </svg>
            <span class="register-card-title">Exam &amp; History</span>
            <span class="register-card-text">Record an exam and weight, or see an animal's history</span>
        </a>
        <a href="/Care/Quarantines" class="register-card">
            <svg viewBox="0 0 64 64" width="88" height="88" aria-hidden="true">
                <path d="M32 6l22 8v16c0 14-10 24-22 28C20 54 10 44 10 30V14z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
                <path d="M32 22v16M24 30h16" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
            </svg>
            <span class="register-card-title">Quarantines</span>
            <span class="register-card-text">@Model.Quarantined in quarantine now</span>
        </a>
        @if (!Model.Keeper)
        {
            <a href="/Care/Tasks" class="register-card">
                <svg viewBox="0 0 64 64" width="88" height="88" aria-hidden="true">
                    <rect x="12" y="8" width="40" height="50" rx="5" fill="none" stroke="currentColor" stroke-width="4" />
                    <path d="M20 24l4 4 7-8M20 40l4 4 7-8M36 24h8M36 40h8" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="register-card-title">My Tasks</span>
                <span class="register-card-text">@Model.MyTasks open</span>
            </a>
        }
    </div>
}

@if (ZooDatabase.Data.ReportAccess.CanView(User))
{
    <h2 class="h4 section-heading mt-5 mb-3">Reports</h2>
    <div class="register-cards">
        <a href="/Reports" class="register-card">
            <svg viewBox="0 0 64 64" width="88" height="88" aria-hidden="true">
                <path d="M8 56h48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
                <rect x="14" y="34" width="8" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="4" />
                <rect x="28" y="22" width="8" height="30" rx="2" fill="none" stroke="currentColor" stroke-width="4" />
                <rect x="42" y="10" width="8" height="42" rx="2" fill="none" stroke="currentColor" stroke-width="4" />
            </svg>
            <span class="register-card-title">Reports</span>
            <span class="register-card-text">Run the feeding, health and habitat reports</span>
        </a>
    </div>
}