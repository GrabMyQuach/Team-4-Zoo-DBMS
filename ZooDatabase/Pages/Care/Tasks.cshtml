@page
@model ZooDatabase.Pages.Care.TasksModel
@{
    ViewData["Title"] = "My Tasks";
}

<partial name="_CareNav" model="@("tasks")" />

<h1 class="mb-1">@(Model.ShowAssigned ? "Open Care Tasks" : "My Tasks")</h1>
<p class="text-muted mb-4">@Model.Tasks.Count open · overdue and urgent first</p>

@if (Model.Tasks.Count == 0)
{
    <div class="card"><div class="card-body"><p class="mb-0">Nothing to do right now. Nice work!</p></div></div>
}
<div class="care-list">
    @foreach (var t in Model.Tasks)
    {
        bool overdue = t.Due != null && t.Due < DateTime.Now;
        <div class="care-row">
            <div class="care-what">
                <span class="fw-semibold">@t.Title</span>
                <span class="text-muted">
                    @if (t.AnimalId != null)
                    {
                        <a href="/Animals/Details/@t.AnimalId">@t.Animal</a>
                    }
                    else
                    {
                        <span>General</span>
                    }
                    @if (Model.ShowAssigned)
                    {
                        <span> · @(t.AssignedTo ?? "Unassigned")</span>
                    }
                </span>
            </div>
            <span class="badge @(t.Priority is "Urgent" or "High" ? "bg-danger" : "bg-secondary") care-status">@(t.Priority ?? "Normal")</span>
            <span class="care-due @(overdue ? "text-danger fw-semibold" : "text-muted")">
                @(t.Due == null ? "No due time" : (overdue ? "Overdue · " : "Due ") + t.Due.Value.ToString("MMM d, h:mm tt"))
            </span>
            <form method="post" asp-page-handler="Done">
                <input type="hidden" name="taskId" value="@t.Id" />
                <button type="submit" class="btn btn-primary">Done</button>
            </form>
        </div>
    }
</div>
