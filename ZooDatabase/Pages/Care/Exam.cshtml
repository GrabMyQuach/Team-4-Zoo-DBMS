@page
@model ZooDatabase.Pages.Care.ExamModel
@using ZooDatabase.Pages.Care
@{
    ViewData["Title"] = "Exam & History";
}

<partial name="_CareNav" model="@("exam")" />

<h1 class="mb-1">Exam &amp; History</h1>
<p class="text-muted mb-4">Find the animal, then record today's exam and weight, or look back at its history.</p>

<form method="get" class="d-flex flex-wrap gap-2 mb-4" role="search">
    <label for="Q" class="visually-hidden">Animal name, species or enclosure</label>
    <input id="Q" name="Q" value="@Model.Q" class="form-control form-control-lg flex-grow-1" style="max-width: 520px" placeholder="Animal name, species or enclosure" autofocus />
    <button type="submit" class="btn btn-primary btn-lg px-4">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Q))
    {
        <a href="/Care/Exam" class="btn btn-link btn-lg">Clear</a>
    }
</form>

@if (Model.Animals.Count == 0)
{
    <p>No animals match "@Model.Q".</p>
}
<div class="care-list">
    @foreach (var a in Model.Animals)
    {
        <div class="care-row">
            @if (a.Photo != null)
            {
                <img src="@a.Photo" alt="" class="animal-thumb care-thumb" loading="lazy" />
            }
            else
            {
                <span class="animal-thumb animal-thumb--empty care-thumb" aria-hidden="true"></span>
            }
            <div class="care-what">
                <a href="/Care/History/@a.Id" class="fw-semibold">@a.Name</a>
                <span class="text-muted">@a.Species · @a.Enclosure</span>
                <span class="d-flex flex-wrap gap-2 mt-1 align-items-center">
                    <span class="badge @CareData.HealthBadge(a.Health)">@(a.Health ?? "Unknown")</span>
                    <span class="text-muted small">Last weight @(a.LastWeight == null ? "—" : a.LastWeight.Value.ToString("0.##") + " kg") · last exam @(a.LastExam?.ToString("MMM d, yyyy") ?? "never")</span>
                </span>
            </div>
            <div class="care-actions">
                <a href="/Animals/HealthNew/@(a.Id)?Back=/Care/History/@(a.Id)" class="btn btn-primary">Record exam</a>
                <a href="/Care/History/@a.Id" class="btn btn-outline-primary">History</a>
            </div>
        </div>
    }
</div>
