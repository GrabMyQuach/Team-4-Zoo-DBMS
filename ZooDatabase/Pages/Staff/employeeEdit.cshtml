@page "{id:int?}"
@model ZooDatabase.Pages.Staff.EmployeeEditModel
@using ZooDatabase.Data
@{
    string title = Model.IsNew ? "Add Employee" : $"Edit {Model.Input.FirstName} {Model.Input.LastName}";
    ViewData["Title"] = title;
    string cancelUrl = Model.IsNew ? "/Staff/Employees" : $"/Staff/EmployeeDetails/{Model.Id}";

    // If an old record has a value that isn't in our list, keep it as a choice so it isn't lost
    string[] WithCurrent(string[] options, string? current) =>
        string.IsNullOrEmpty(current) || options.Contains(current) ? options : options.Append(current).ToArray();
}

<a href="@cancelUrl" class="back-link mt-0 mb-3 d-inline-block">← Back</a>

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">@title</h1>
</div>

<div class="card" style="max-width: 820px;">
    <div class="card-body p-4">
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }

        <form method="post">
            <h2 class="h6 text-muted text-uppercase mb-3">Person</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">First name *</label>
                    <input asp-for="Input.FirstName" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Middle name</label>
                    <input asp-for="Input.MiddleName" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Last name *</label>
                    <input asp-for="Input.LastName" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Gender</label>
                    <select asp-for="Input.Gender" class="form-select">
                        <option value="">Not recorded</option>
                        @foreach (var g in WithCurrent(StaffOptions.Genders, Model.Input.Gender))
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Phone</label>
                    <input asp-for="Input.Phone" class="form-control" placeholder="713-555-0100" maxlength="20" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">SSN @(Model.IsNew ? "*" : "")</label>
                    <input asp-for="Input.Ssn" class="form-control" autocomplete="off" maxlength="11"
                           placeholder="@(Model.IsNew ? "123-45-6789" : "Leave blank to keep " + Model.CurrentSsnMasked)" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Address</label>
                    <input asp-for="Input.Address" class="form-control" maxlength="255" />
                </div>
            </div>

            <h2 class="h6 text-muted text-uppercase mb-3">Job</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Department *</label>
                    <select asp-for="Input.DepartmentId" class="form-select">
                        <option value="0">Choose a department…</option>
                        @foreach (var d in Model.DepartmentOptions)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Job title</label>
                    <input asp-for="Input.JobPosition" class="form-control" placeholder="e.g. Senior Keeper" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Employment type</label>
                    <select asp-for="Input.EmploymentType" class="form-select">
                        @foreach (var t in WithCurrent(StaffOptions.EmploymentTypes, Model.Input.EmploymentType))
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Hire date</label>
                    <input asp-for="Input.HireDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Pay type</label>
                    <select asp-for="Input.PayType" class="form-select">
                        @foreach (var p in WithCurrent(StaffOptions.PayTypes, Model.Input.PayType))
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Pay rate</label>
                    <input asp-for="Input.PayRate" type="number" step="0.01" min="0" class="form-control" />
                </div>
            </div>

            <h2 class="h6 text-muted text-uppercase mb-3">Specialty</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Works as</label>
                    <select asp-for="Input.Specialty" class="form-select" id="specialty">
                        @foreach (var s in StaffOptions.Specialties)
                        {
                            <option value="@s">@(s == "None" ? "Other staff" : s)</option>
                        }
                    </select>
                </div>
                <div class="col-md-8" id="keeper-fields">
                    <label class="form-label fw-semibold">Experience level</label>
                    <select asp-for="Input.ExperienceLevel" class="form-select">
                        @foreach (var l in WithCurrent(StaffOptions.ExperienceLevels, Model.Input.ExperienceLevel))
                        {
                            <option value="@l">@l</option>
                        }
                    </select>
                </div>
                <div class="col-md-8" id="vet-fields">
                    <label class="form-label fw-semibold">Specialization</label>
                    <input asp-for="Input.Specialization" class="form-control" placeholder="e.g. Large Mammals" maxlength="100" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">@(Model.IsNew ? "Add Employee" : "Save Changes")</button>
                <a href="@cancelUrl" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Show only the field that matches the chosen specialty
        (function () {
            var select = document.getElementById('specialty');
            function update() {
                document.getElementById('keeper-fields').style.display = select.value === 'Keeper' ? '' : 'none';
                document.getElementById('vet-fields').style.display = select.value === 'Veterinarian' ? '' : 'none';
            }
            select.addEventListener('change', update);
            update();
        })();
    </script>
}
