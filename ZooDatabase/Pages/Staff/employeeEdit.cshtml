
@page "{id:int}"
@model ZooDatabase.Pages.Staff.EmployeeEditModel

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-4">
    <h1>Edit Employee</h1>

    <form method="post">
        <input type="hidden" asp-for="Employee.EmployeeId" />

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Employee ID</label>
            <input class="form-control"
                   value="@Model.Employee.EmployeeId"
                   disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">SSN</label>
            <input asp-for="Employee.SSN"
                   class="form-control"
                   maxlength="9" />
        </div>

        <div class="mb-3">
            <label class="form-label">First Name</label>
            <input asp-for="Employee.FirstName"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Middle Name</label>
            <input asp-for="Employee.MiddleName"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input asp-for="Employee.LastName"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Address</label>
            <input asp-for="Employee.Address"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Gender</label>
            <select asp-for="Employee.Gender"
                    class="form-select">
                <option value="">Select Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <input asp-for="Employee.PhoneNumber"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Job Position</label>
            <input asp-for="Employee.JobPosition"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Hire Date</label>
            <input asp-for="Employee.HireDate"
                   type="date"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Department ID</label>
            <input asp-for="Employee.DepartmentId"
                   type="number"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Employment Type</label>
            <input asp-for="Employee.EmploymentType"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Pay Type</label>
            <input asp-for="Employee.PayType"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Pay Rate</label>
            <input asp-for="Employee.PayRate"
                   type="number"
                   step="0.01"
                   class="form-control" />
        </div>

        <button type="submit"
                class="btn btn-success">
            Save Changes
        </button>

        <a asp-page="./EmployeeManage"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
