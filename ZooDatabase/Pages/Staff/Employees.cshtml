@page
@model ZooDatabase.Pages.Staff.EmployeesModel
@{
    ViewData["Title"] = "Employees";
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">Employees</h1>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">@Model.Rows.Count employees</h2>
    @if (!User.IsInRole("ReadOnly"))
    {
        <a href="/Staff/EmployeeManage" class="btn btn-primary rounded-pill px-4">Manage Employees</a>
    }
</div>

<div class="card">
    <div class="card-body border-bottom">
        <form method="get" class="d-flex gap-2" style="max-width: 480px;">
            <input type="text" name="Search" value="@Model.Search" class="form-control"
                   placeholder="Search name, job, or department" />
            <button type="submit" class="btn btn-outline-secondary rounded-pill px-4">Search</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Job</th>
                    <th>Department</th>
                    <th>Type</th>
                    <th>Hired</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Rows)
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">@e.Name</span>
                            @if (e.Specialty != null)
                            {
                                <span class="badge bg-success ms-1">@e.Specialty</span>
                            }
                        </td>
                        <td>@e.JobPosition</td>
                        <td>@e.Department</td>
                        <td>@e.EmploymentType</td>
                        <td>@(e.HireDate?.ToString("MMM d, yyyy") ?? "—")</td>
                        <td>@e.Phone</td>
                    </tr>
                }

                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No employees found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
