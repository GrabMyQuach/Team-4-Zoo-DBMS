@page "{id:int}"
@model ZooDatabase.Pages.Staff.DepartmentDetailsModel
@{
    ViewData["Title"] = Model.Name;
}

<a href="/Staff/Departments" class="back-link mt-0 mb-3 d-inline-block">← All departments</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="border-bottom pb-3 mb-4 d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1 class="h2 mb-1">@Model.Name</h1>
        <div class="text-muted">
            @(Model.Location ?? "No location")
            @if (Model.Phone != null)
            {
                <span>· @Model.Phone</span>
            }
        </div>
    </div>
    @if (Model.CanEdit)
    {
        <a href="/Staff/DepartmentEdit/@Model.Id" class="btn btn-primary rounded-pill px-4">Edit</a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Manager</div>
            <div class="stat-value fs-5">
                @if (Model.ManagerId != null)
                {
                    <a href="/Staff/EmployeeDetails/@Model.ManagerId" class="text-decoration-none">@Model.Manager</a>
                }
                else
                {
                    <span class="text-warning">Not assigned</span>
                }
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Staff</div>
            <div class="stat-value">@Model.Staff.Count</div>
            <div class="small text-muted">@Model.FullTime full-time · @Model.Volunteers.Count volunteers</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Hours, last 30 days</div>
            <div class="stat-value">@Model.TotalHours.ToString("0")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Absences, last 30 days</div>
            <div class="stat-value">@Model.TotalAbsences</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Staff</h2></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Name</th><th>Job</th><th>Type</th><th class="text-end">Hours, 30 days</th><th class="text-end">Absences</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Staff)
                        {
                            <tr class="clickable-row @(s.Absences30 >= 3 ? "table-warning" : "")" onclick="location.href='/Staff/EmployeeDetails/@s.EmployeeId'">
                                <td class="fw-semibold">@s.Name</td>
                                <td>@s.JobPosition</td>
                                <td>@s.EmploymentType</td>
                                <td class="text-end">@s.Hours30.ToString("0.#")</td>
                                <td class="text-end">@s.Absences30</td>
                            </tr>
                        }
                        @if (Model.Staff.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No staff in this department.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body pb-0"><h2 class="h5 section-heading">Volunteers</h2></div>
            <table class="table align-middle mb-0">
                <tbody>
                    @foreach (var v in Model.Volunteers)
                    {
                        <tr>
                            <td class="fw-semibold">@v.Name</td>
                            <td class="small text-muted">@v.Status @(v.Since == null ? "" : "· since " + v.Since.Value.ToString("MMM yyyy"))</td>
                        </tr>
                    }
                    @if (Model.Volunteers.Count == 0)
                    {
                        <tr><td class="text-center text-muted py-3">No active volunteers.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
