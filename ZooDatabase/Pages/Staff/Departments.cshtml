@page
@model ZooDatabase.Pages.Staff.DepartmentsModel
@{
    ViewData["Title"] = "Departments";
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">Departments</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">@Model.Rows.Count departments</h2>
    @if (Model.CanEdit)
    {
        <a href="/Staff/DepartmentEdit" class="btn btn-primary rounded-pill px-4">+ Add Department</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Department</th>
                    <th>Manager</th>
                    <th class="text-end">Staff</th>
                    <th class="text-end">Volunteers</th>
                    <th class="text-end">Hours, 30 days</th>
                    <th class="text-end">Absences, 30 days</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Rows)
                {
                    <tr class="clickable-row" onclick="location.href='/Staff/DepartmentDetails/@d.DepartmentId'">
                        <td>
                            <a href="/Staff/DepartmentDetails/@d.DepartmentId" class="fw-semibold text-decoration-none text-dark">@d.Name</a>
                            @if (d.Location != null)
                            {
                                <div class="small text-muted">@d.Location</div>
                            }
                        </td>
                        <td>@(d.Manager ?? "—")</td>
                        <td class="text-end">@d.Staff</td>
                        <td class="text-end">@d.Volunteers</td>
                        <td class="text-end">@d.Hours30.ToString("0")</td>
                        <td class="text-end">@d.Absences30</td>
                        <td class="text-end text-muted">›</td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No departments yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
