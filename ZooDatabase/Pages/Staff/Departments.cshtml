@page
@model ZooDatabase.Pages.Staff.DepartmentsModel
@{
    ViewData["Title"] = "Departments";
}

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">Departments</h1>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Department</th>
                    <th>Location</th>
                    <th>Phone</th>
                    <th class="text-end">Staff</th>
                    <th class="text-end">Volunteers</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Rows)
                {
                    <tr>
                        <td class="fw-semibold">@d.Name</td>
                        <td>@d.Location</td>
                        <td>@d.Phone</td>
                        <td class="text-end">@d.StaffCount</td>
                        <td class="text-end">@d.VolunteerCount</td>
                    </tr>
                }

                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No departments found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>