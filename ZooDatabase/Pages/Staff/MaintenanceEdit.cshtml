@page "{id:int?}"
@model ZooDatabase.Pages.Staff.MaintenanceEditModel
@using ZooDatabase.Data
@{
    ViewData["Title"] = Model.IsNew ? "New Maintenance Request" : $"Maintenance Request #{Model.Id}";
}

<a href="/Staff/Maintenance" class="back-link mt-0 mb-3 d-inline-block">← Back</a>

<div class="border-bottom pb-3 mb-4">
    <h1 class="h2 mb-0">@(Model.IsNew ? "New Maintenance Request" : $"Maintenance Request #{Model.Id}")</h1>
    @if (Model.InspectionId != null)
    {
        <div class="text-muted mt-1">Opened automatically by critical inspection #@Model.InspectionId</div>
    }
</div>

<div class="card" style="max-width: 760px;">
    <div class="card-body p-4">

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">What needs to be done *</label>
                    <input asp-for="Input.Description" class="form-control" maxlength="255"
                           placeholder="e.g. Repair lion enclosure latch" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Where</label>
                    <select asp-for="Input.Place" class="form-select">
                        <option value="">Somewhere else (type below)</option>
                        @foreach (var g in Model.PlaceGroups)
                        {
                            <optgroup label="@g.Label">
                                @foreach (var p in g.Places)
                                {
                                    <option value="@p.Value">@p.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Location</label>
                    <input asp-for="Input.Location" class="form-control" maxlength="100"
                           placeholder="Filled in from the place if left blank" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Priority *</label>
                    <select asp-for="Input.Priority" class="form-select">
                        @foreach (var p in StaffOptions.MaintenancePriorities)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Status *</label>
                    <select asp-for="Input.Status" class="form-select">
                        @foreach (var s in StaffOptions.MaintenanceStatuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Assigned to</label>
                    <select asp-for="Input.EmployeeId" class="form-select">
                        <option value="0">Unassigned</option>
                        @foreach (var e in Model.EmployeeOptions)
                        {
                            <option value="@e.Id">@e.Label</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Requested</label>
                    <input asp-for="Input.RequestDate" type="date" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Completed</label>
                    <input asp-for="Input.CompletionDate" type="date" class="form-control" />
                    <div class="form-text">Set to today automatically when marked Completed.</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Cost ($)</label>
                    <input asp-for="Input.Cost" type="number" step="0.01" min="0" class="form-control" />
                </div>

                <div class="col-12">
                    <div class="form-text p-3 border rounded bg-light">
                        Marking an <strong>Emergency</strong> repair on an enclosure as <strong>Completed</strong>
                        creates a re-inspection task. The enclosure reopens once that inspection passes.
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    @(Model.IsNew ? "Create Request" : "Save Changes")
                </button>
                <a href="/Staff/Maintenance" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>
